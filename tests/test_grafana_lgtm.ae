// Ported from testcontainers-go modules/grafana-lgtm/grafana_test.go
//
// A real grafana/otel-lgtm: Grafana's /api/health answers ok at http_endpoint,
// the admin credentials the block set work against /api/user, Prometheus,
// Loki and Tempo answer their readiness endpoints, and the OTLP/HTTP
// endpoint accepts an (empty) trace export. Go's test exports traces with the
// OpenTelemetry SDK.

import std.spec
import std.string
import std.encoding
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.grafana_lgtm

const IMAGE = "grafana/otel-lgtm:0.6.0"

// (status, body, error); user "" sends no Authorization.
fn http_call(method: string, url: string, user: string, pw: string, body: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 30s)
    if string.length(user) > 0 {
        client.set_header(req, "Authorization", "Basic ${encoding.base64_encode_padded(string.bytes("${user}:${pw}"))}")
    }
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "application/json") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    out = client.response_body(r)
    client.response_free(r)
    return st, out, ""
}

// Loki and Tempo answer 503 for a while after the stack reports up: poll
// their readiness endpoint until 200 (up to 90 s).
fn ready_status(url: string) -> (int, string) {
    st = 0
    err = ""
    tries = 0
    while tries < 45 {
        st, _, err = http_call("GET", url, "", "", "")
        if err == "" && st == 200 { return st, "" }
        sleep(2000)
        tries = tries + 1
    }
    return st, err
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/grafana_lgtm") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves every endpoint (TestGrafanaLTGM)") callback {
            c, err = grafana_lgtm.run(IMAGE) { admin_credentials("lgtm-admin", "lgtm-secret") }
            testing.cleanup_container(c)
            spec.assert_ok(err, "grafana lgtm starts")
            if err == "" {
                g, gerr = grafana_lgtm.http_endpoint(c)
                spec.assert_ok(gerr, "grafana endpoint")
                hs, hb, herr = http_call("GET", "http://${g}/api/health", "", "", "")
                spec.assert_ok(herr, "GET /api/health")
                spec.assert_eq(hs, 200, "grafana is healthy")
                spec.assert_contains(hb, "\"database\": \"ok\"", "database ok")
                us, ub, uerr = http_call("GET", "http://${g}/api/user", "lgtm-admin", "lgtm-secret", "")
                spec.assert_ok(uerr, "GET /api/user")
                spec.assert_eq(us, 200, "the admin credentials work: ${ub}")
                bs, _, berr = http_call("GET", "http://${g}/api/user", "lgtm-admin", "admin", "")
                spec.assert_ok(berr, "wrong password request")
                spec.assert_eq(bs, 401, "the default password does not")

                p, perr = grafana_lgtm.prometheus_http_endpoint(c)
                spec.assert_ok(perr, "prometheus endpoint")
                ps, _, pherr = http_call("GET", "http://${p}/-/ready", "", "", "")
                spec.assert_ok(pherr, "GET prometheus /-/ready")
                spec.assert_eq(ps, 200, "prometheus ready")

                l, lerr = grafana_lgtm.loki_endpoint(c)
                spec.assert_ok(lerr, "loki endpoint")
                ls, lherr = ready_status("http://${l}/ready")
                spec.assert_ok(lherr, "GET loki /ready")
                spec.assert_eq(ls, 200, "loki ready")

                t, terr = grafana_lgtm.tempo_endpoint(c)
                spec.assert_ok(terr, "tempo endpoint")
                ts, therr = ready_status("http://${t}/ready")
                spec.assert_ok(therr, "GET tempo /ready")
                spec.assert_eq(ts, 200, "tempo ready")

                o, oerr = grafana_lgtm.otlp_http_endpoint(c)
                spec.assert_ok(oerr, "otlp http endpoint")
                os, ob, oherr = http_call("POST", "http://${o}/v1/traces", "", "", "{\"resourceSpans\":[]}")
                spec.assert_ok(oherr, "POST otlp /v1/traces")
                spec.assert_eq(os, 200, "the collector accepts an OTLP/JSON export: ${ob}")

                _, grpc_err = grafana_lgtm.otlp_grpc_endpoint(c)
                spec.assert_ok(grpc_err, "otlp grpc endpoint")
            }
        }
    }
    return spec.run_summary(fw)
}
