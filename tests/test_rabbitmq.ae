// Ported from testcontainers-go modules/rabbitmq/rabbitmq_test.go
//
// A real RabbitMQ: the AMQP 0-9-1 protocol header is sent to the mapped AMQP
// port and the broker's Connection.Start frame is read back, and the
// management HTTP API is called with the module's credentials (the
// right ones answer 200, guest/guest on a custom-credentials broker 401).
// Not ported: the Go tests that need a client library (amqp091-go) to
// publish and consume, and the TLS connection (needs generated certificates);
// ssl() is checked on a created, not started, container (config and files).

import std.spec
import std.string
import std.tcp
import std.bytes
import std.encoding
import std.json
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.rabbitmq

const IMAGE = "rabbitmq:3.12.11-management-alpine"

// GET url with basic auth: (status, body, error).
fn http_get(url: string, user: string, password: string) -> (int, string, string) {
    req = client.request("GET", url)
    client.set_timeout(req, 10s)
    cred = encoding.base64_encode_padded(string.bytes("${user}:${password}"))
    client.set_header(req, "Authorization", "Basic ${cred}")
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    status = client.response_status(r)
    body = client.response_body(r)
    client.response_free(r)
    return status, body, ""
}

// The management API starts a moment after the broker: retry a few times.
fn mgmt_get(rc: *rabbitmq.RabbitMQContainer, path: string, user: string, password: string) -> (int, string, string) {
    base, berr = rabbitmq.http_url(rc)
    if berr != "" { return 0, "", berr }
    status = 0
    body = ""
    err = ""
    tries = 0
    while tries < 30 {
        status, body, err = http_get("${base}${path}", user, password)
        if err == "" && status != 0 { return status, body, "" }
        tries = tries + 1
    }
    return status, body, err
}

// Send the AMQP 0-9-1 protocol header and read Connection.Start: returns the
// frame's (type, channel, class, method, version major, minor) as text.
fn amqp_handshake(rc: *rabbitmq.RabbitMQContainer) -> (string, string) {
    h, _ = tc.host(rc.container)
    port, perr = tc.mapped_port(rc.container, rabbitmq.AMQP_PORT)
    if perr != "" { return "", perr }
    sock, cerr = tcp.connect(h, port)
    if cerr != "" { return "", cerr }
    hdr = bytes.new(8)
    bytes.set(hdr, 0, 65)
    bytes.set(hdr, 1, 77)
    bytes.set(hdr, 2, 81)
    bytes.set(hdr, 3, 80)
    bytes.set(hdr, 4, 0)
    bytes.set(hdr, 5, 0)
    bytes.set(hdr, 6, 9)
    bytes.set(hdr, 7, 1)
    _, werr = tcp.write_all(sock, bytes.view(hdr))
    bytes.free(hdr)
    if werr != "" { tcp.tcp_close(sock); return "", werr }
    buf = bytes.new(512)
    got = 0
    tries = 0
    while got < 13 && tries < 100 {
        n, rerr = tcp.read_into(sock, bytes.capacity_view(buf))
        if rerr != "" && rerr != "timeout" { break }
        if n > 0 {
            // keep what the first read gave (Connection.Start fits in one segment)
            got = got + n
            bytes.set_length(buf, got)
            break
        }
        tries = tries + 1
    }
    tcp.tcp_close(sock)
    if got < 13 { bytes.free(buf); return "", "short reply: ${got} bytes" }
    v = bytes.view(buf)
    out = "${v[0]},${v[1] * 256 + v[2]},${v[7] * 256 + v[8]},${v[9] * 256 + v[10]},${v[11]}.${v[12]}"
    bytes.free(buf)
    return out, ""
}

fn assert_broker_speaks_amqp(rc: *rabbitmq.RabbitMQContainer) {
    frame, err = amqp_handshake(rc)
    spec.assert_ok(err, "AMQP handshake")
    // method frame (1) on channel 0, class 10 (connection) method 10 (start), AMQP 0.9
    spec.assert_str_eq(frame, "1,0,10,10,0.9", "the broker answers the protocol header with Connection.Start")
}

fn queue_free(rc: *rabbitmq.RabbitMQContainer) {
    testing.cleanup_container(rc.container)
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/rabbitmq") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("speaks AMQP and answers the management API as guest (TestRunContainer_connectUsingAmqp)") callback {
            rc, err = rabbitmq.run(IMAGE)
            if rc != null { queue_free(rc) }
            spec.assert_ok(err, "rabbitmq starts")
            if err == "" {
                url, uerr = rabbitmq.amqp_url(rc)
                spec.assert_ok(uerr, "amqp url")
                spec.assert_true(string.starts_with(url, "amqp://guest:guest@") == 1, "amqp URL carries the default credentials: ${url}")
                assert_broker_speaks_amqp(rc)
                status, body, herr = mgmt_get(rc, "/api/overview", "guest", "guest")
                spec.assert_ok(herr, "management API")
                spec.assert_eq(status, 200, "management API with guest/guest")
                spec.assert_contains(body, "rabbitmq_version", "an overview document")
                bad, _, _ = mgmt_get(rc, "/api/overview", "guest", "wrong")
                spec.assert_eq(bad, 401, "management API with a wrong password")
            }
        }

        spec.it("applies custom credentials (TestRunContainer_withCustomCredentials)") callback {
            rc, err = rabbitmq.run(IMAGE) {
                admin_username("tcae-user")
                admin_password("tcae-s3cret")
            }
            if rc != null { queue_free(rc) }
            spec.assert_ok(err, "rabbitmq starts")
            if err == "" {
                spec.assert_str_eq(rc.admin_username, "tcae-user", "the struct carries the user")
                url, _ = rabbitmq.amqp_url(rc)
                spec.assert_true(string.starts_with(url, "amqp://tcae-user:tcae-s3cret@") == 1, "amqp URL: ${url}")
                assert_broker_speaks_amqp(rc)
                ok, body, herr = mgmt_get(rc, "/api/whoami", "tcae-user", "tcae-s3cret")
                spec.assert_ok(herr, "management API")
                spec.assert_eq(ok, 200, "the custom user is accepted")
                spec.assert_contains(body, "tcae-user", "whoami names the custom user")
                guest, _, _ = mgmt_get(rc, "/api/whoami", "guest", "guest")
                spec.assert_eq(guest, 401, "guest is gone")
            }
        }

        spec.it("shapes the URLs (AmqpURL, AmqpsURL, HttpURL, HttpsURL)") callback {
            rc, err = rabbitmq.run(IMAGE)
            if rc != null { queue_free(rc) }
            spec.assert_ok(err, "rabbitmq starts")
            if err == "" {
                a, _ = rabbitmq.amqps_url(rc)
                spec.assert_true(string.starts_with(a, "amqps://guest:guest@localhost:") == 1, "amqps URL: ${a}")
                h, _ = rabbitmq.http_url(rc)
                spec.assert_true(string.starts_with(h, "http://localhost:") == 1, "http URL: ${h}")
                hs, _ = rabbitmq.https_url(rc)
                spec.assert_true(string.starts_with(hs, "https://localhost:") == 1, "https URL: ${hs}")
                p, _ = tc.mapped_port(rc.container, rabbitmq.HTTP_PORT)
                spec.assert_true(string.ends_with(h, ":${p}") == 1, "the http URL uses the mapped management port")
            }
        }

        spec.it("renders the node config and copies the TLS files (TestRunContainer_connectUsingAmqps)") callback {
            pem = "modules/rabbitmq/testdata/placeholder.pem"
            rc, err = rabbitmq.run(IMAGE) {
                admin_username("alice")
                admin_password("pw")
                ssl(pem, pem, pem, rabbitmq.SSL_VERIFY_PEER, true, 8)
                tc.no_start()
            }
            if rc != null { queue_free(rc) }
            spec.assert_ok(err, "rabbitmq is created")
            if err == "" {
                conf, cerr = tc.copy_file_from_container(rc.container, rabbitmq.CUSTOM_CONF_PATH)
                spec.assert_ok(cerr, "the config file is in the container")
                spec.assert_contains(conf, "default_user = alice", "credentials rendered")
                spec.assert_contains(conf, "default_pass = pw", "credentials rendered")
                spec.assert_contains(conf, "listeners.ssl.default = 5671", "SSL listener")
                spec.assert_contains(conf, "ssl_options.verify = verify_peer", "verification mode")
                spec.assert_contains(conf, "ssl_options.fail_if_no_peer_cert = true", "fail if no cert")
                spec.assert_contains(conf, "ssl_options.depth = 8", "depth")
                cert, kerr = tc.copy_file_from_container(rc.container, "/etc/rabbitmq/rabbitmq_key.pem")
                spec.assert_ok(kerr, "the key file is in the container")
                spec.assert_contains(cert, "placeholder", "it is the file we gave")
                doc, ierr = tc.inspect(rc.container)
                spec.assert_ok(ierr, "inspect")
                cfg, _ = json.object_get(doc, "Config")
                ev, _ = json.object_get(cfg, "Env")
                envs, _ = json.encode(ev)
                spec.assert_false(string.contains(envs, "TCAE_") == 1, "no module setting in the container's env: ${envs}")
                spec.assert_false(string.contains(envs, "ssl_options") == 1, "the SSL fragment is only in the config file")
                json.free(doc)
            }
        }
    }
    return spec.run_summary(fw)
}
