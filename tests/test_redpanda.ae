// Ported from testcontainers-go modules/redpanda/redpanda_test.go (TestRedpanda,
// TestRedpandaWithAuthentication's service account, TestRedpandaWithAutoCreateTopics)
//
// A real Redpanda, started through the wrapper entrypoint and the node config
// copied in once the Kafka port is mapped. Checked over HTTP: the Admin API
// says it is ready, the Schema Registry registers a schema and lists its
// subject, and a service account created by new_service_account shows up in
// the Admin API's user list. The Kafka seed broker is host:port.

import std.spec
import std.string
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.redpanda

const IMAGE = "docker.io/redpandadata/redpanda:v25.2.4"   // the Hub name of Go's docker.redpanda.com image (same image; that registry rate-limits)

fn http(method: string, url: string, body: string, ctype: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 30s)
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), ctype) }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    out = client.response_body(r)
    client.response_free(r)
    return st, out, ""
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/redpanda") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves the Admin API and Schema Registry (TestRedpanda)") callback {
            rp, err = redpanda.run(IMAGE) {
                new_service_account("tcae-user", "tcae-pass")
                superusers(["tcae-user"])
            }
            if rp != null { testing.cleanup_container(rp.container) }
            spec.assert_ok(err, "redpanda starts")
            if err == "" {
                broker, berr = redpanda.kafka_seed_broker(rp)
                spec.assert_ok(berr, "seed broker")
                spec.assert_contains(broker, "localhost:", "host:port: ${broker}")

                admin, aerr = redpanda.admin_api_address(rp)
                spec.assert_ok(aerr, "admin address")
                st, body, gerr = http("GET", "${admin}/v1/status/ready", "", "")
                spec.assert_ok(gerr, "GET /v1/status/ready")
                spec.assert_eq(st, 200, "the Admin API answers")
                spec.assert_contains(body, "ready", "the node is ready")
                st1, users, uerr = http("GET", "${admin}/v1/security/users", "", "")
                spec.assert_ok(uerr, "GET /v1/security/users")
                spec.assert_eq(st1, 200, "users listed")
                spec.assert_contains(users, "tcae-user", "the service account was created")

                sr, srerr = redpanda.schema_registry_address(rp)
                spec.assert_ok(srerr, "schema registry address")
                schema = "{\"schema\": \"{\\\"type\\\": \\\"string\\\"}\"}"
                st2, rbody, perr = http("POST", "${sr}/subjects/tcae-value/versions", schema, "application/vnd.schemaregistry.v1+json")
                spec.assert_ok(perr, "register a schema")
                spec.assert_eq(st2, 200, "schema registered: ${rbody}")
                _st3, subjects, lerr = http("GET", "${sr}/subjects", "", "")
                spec.assert_ok(lerr, "GET /subjects")
                spec.assert_contains(subjects, "tcae-value", "the subject is listed")
            }
        }
    }
    return spec.run_summary(fw)
}
