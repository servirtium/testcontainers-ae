// Ported from testcontainers-go modules/mariadb/mariadb_test.go
//
// A real MariaDB. Two ways to show it is up, as the task asks and as Go does:
// the server's handshake packet over std.tcp at the mapped port (protocol
// version 10 and the server version string; Aether's std has no SQL client,
// so the wire protocol stops at the greeting), and real SQL through the
// mysql client inside the image over TCP (Go's runSQL), which also proves
// the credentials, the database, init scripts and the config file.

import std.spec
import std.string
import std.tcp
import std.json
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.mariadb

const IMAGE = "mariadb:12.3.2"

// Read the server greeting: (protocol version, server version, error). The
// packet is 3 bytes length, 1 byte sequence, then protocol byte 10 and the
// NUL-terminated server version.
// The container's Config.Env as JSON text.
fn container_env(c: *docker.Container) -> string {
    doc, err = tc.inspect(c)
    if err != "" { return "" }
    cfg, _ = json.object_get(doc, "Config")
    ev, _ = json.object_get(cfg, "Env")
    out, _ = json.encode(ev)
    json.free(doc)
    return out
}

fn greeting(host: string, port: int) -> (int, string, string) {
    sock, cerr = tcp.connect(host, port)
    if cerr != "" { return 0, "", cerr }
    buf = ""
    total = 0
    tries = 0
    while tries < 100 && total < 16 {
        chunk, n, rerr = tcp.read_n(sock, 512)
        if rerr != "" && rerr != "timeout" { tcp.tcp_close(sock); return 0, "", rerr }
        if n > 0 {
            if total == 0 { buf = chunk }
            else { buf = string.concat(buf, chunk) }
            total = total + n
        }
        tries = tries + 1
    }
    tcp.tcp_close(sock)
    if total < 6 { return 0, "", "short greeting (${total} bytes)" }
    proto = string.char_at_n(buf, total, 4)
    ver = ""
    i = 5
    while i < total {
        ch = string.char_at_n(buf, total, i)
        if ch == 0 { i = total } else { ver = "${ver}${string.from_char(ch)}"; i = i + 1 }
    }
    return proto, ver, ""
}

// Go's runSQL: the in-image client over TCP; returns trimmed output, "" and
// an error string on a non-zero exit.
fn run_sql(m: *mariadb.MariaDBContainer, user: string, pw: string, db: string, query: string) -> (string, string) {
    res, err = tc.exec_with(m.container, [
        "sh", "-c", "if command -v mariadb >/dev/null 2>&1; then exec mariadb \"$@\"; else exec mysql \"$@\"; fi",
        "mariadb-client", "--skip-ssl", "--protocol=TCP", "--host=127.0.0.1", "--port=3306",
        "--connect-timeout=10", "--user=${user}", "--database=${db}",
        "--batch", "--skip-column-names", "--execute=${query}"
    ], "", "", ["MYSQL_PWD=${pw}"])
    if err != "" { return "", err }
    if res.exit_code != 0 { return "", "mariadb exited ${res.exit_code}: ${res.output}" }
    return string.trim(res.output), ""
}

fn check_greeting(m: *mariadb.MariaDBContainer) {
    h, _ = tc.host(m.container)
    port, perr = tc.mapped_port(m.container, mariadb.PORT)
    spec.assert_ok(perr, "mapped port")
    proto, ver, gerr = greeting(h, port)
    spec.assert_ok(gerr, "read the greeting from ${h}:${port}")
    spec.assert_eq(proto, 10, "handshake protocol version 10")
    spec.assert_true(string.contains(ver, "12.3.2") == 1 && string.contains(ver, "MariaDB") == 1, "server version is 12.3.2-MariaDB: ${ver}")
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/mariadb") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("starts with the default credentials (TestMariaDB)") callback {
            m, err = mariadb.run(IMAGE)
            if m != null { testing.cleanup_container(m.container) }
            spec.assert_ok(err, "mariadb starts")
            if err == "" {
                dsn, derr = mariadb.connection_string(m, "tls=skip-verify")
                spec.assert_ok(derr, "connection string")
                spec.assert_true(string.starts_with(dsn, "test:test@tcp(") == 1, "user:password@tcp(: ${dsn}")
                spec.assert_true(string.contains(dsn, ")/test?tls=skip-verify") == 1, "/database?args: ${dsn}")
                spec.assert_true(string.ends_with(dsn, "?tls=skip-verify") == 1, "ends with the args")
                plain, _ = mariadb.connection_string(m, "")
                spec.assert_true(string.ends_with(plain, ")/test") == 1, "no ? without args: ${plain}")
                check_greeting(m)
                _, serr = run_sql(m, "test", "test", "test", "CREATE TABLE IF NOT EXISTS a_table (col_1 VARCHAR(128) NOT NULL, col_2 VARCHAR(128) NOT NULL, PRIMARY KEY (col_1, col_2))")
                spec.assert_ok(serr, "CREATE TABLE as test/test")
            }
        }

        spec.it("takes a custom database, user and password") callback {
            m, err = mariadb.run(IMAGE) {
                database("foo")
                username("alice")
                password("s3cret")
            }
            if m != null { testing.cleanup_container(m.container) }
            spec.assert_ok(err, "mariadb starts")
            if err == "" {
                dsn, _ = mariadb.connection_string(m, "")
                spec.assert_true(string.starts_with(dsn, "alice:s3cret@tcp(") == 1, "custom credentials in the DSN: ${dsn}")
                spec.assert_true(string.ends_with(dsn, ")/foo") == 1, "custom database in the DSN: ${dsn}")
                who, serr = run_sql(m, "alice", "s3cret", "foo", "SELECT CURRENT_USER(), DATABASE()")
                spec.assert_ok(serr, "the server accepts alice/s3cret on foo")
                spec.assert_contains(who, "alice@", "logged in as alice")
                spec.assert_contains(who, "foo", "in database foo")
                _, bad = run_sql(m, "alice", "wrong", "foo", "SELECT 1")
                spec.assert_true(string.length(bad) > 0, "a wrong password is refused")
            }
        }

        spec.it("refuses a non-root user with an empty password (TestMariaDBWithNonRootUserAndEmptyPassword)") callback {
            m, err = mariadb.run(IMAGE) {
                database("foo")
                username("test")
                password("")
            }
            if m != null { testing.cleanup_container(m.container) }
            spec.assert_contains(err, "empty password can be used only with the root user", "the credentials check")
            spec.assert_true(m == null, "no container was started")
        }

        spec.it("allows root with an empty password (TestMariaDBWithRootUserAndEmptyPassword)") callback {
            m, err = mariadb.run(IMAGE) {
                database("foo")
                username("root")
                password("")
            }
            if m != null { testing.cleanup_container(m.container) }
            spec.assert_ok(err, "mariadb starts")
            if err == "" {
                dsn, _ = mariadb.connection_string(m, "")
                spec.assert_true(string.starts_with(dsn, "root:@tcp(") == 1, "root with no password: ${dsn}")
                check_greeting(m)
                _, serr = run_sql(m, "root", "", "foo", "CREATE TABLE IF NOT EXISTS a_table (col_1 VARCHAR(128) NOT NULL, PRIMARY KEY (col_1))")
                spec.assert_ok(serr, "CREATE TABLE as root with no password")
                envs = container_env(m.container)
                spec.assert_false(string.contains(envs, "\"MARIADB_USER=") == 1, "MARIADB_USER is dropped, not set empty: ${envs}")
                spec.assert_false(string.contains(envs, "\"MYSQL_USER=") == 1, "and so not mirrored")
                spec.assert_false(string.contains(envs, "\"MARIADB_PASSWORD=") == 1, "MARIADB_PASSWORD is dropped")
                spec.assert_contains(envs, "\"MARIADB_ALLOW_EMPTY_ROOT_PASSWORD=yes\"", "empty root password allowed")
                spec.assert_contains(envs, "\"MYSQL_ALLOW_EMPTY_ROOT_PASSWORD=yes\"", "mirrored as MYSQL_*")
            }
        }

        spec.it("runs init scripts (TestMariaDBWithScripts)") callback {
            m, err = mariadb.run(IMAGE) {
                scripts(["modules/mariadb/testdata/schema.sql"])
            }
            if m != null { testing.cleanup_container(m.container) }
            spec.assert_ok(err, "mariadb starts")
            if err == "" {
                name, serr = run_sql(m, "test", "test", "test", "SELECT name from profile")
                spec.assert_ok(serr, "SELECT")
                spec.assert_str_eq(name, "profile 1", "the script's row")
            }
        }

        spec.it("old images get the MYSQL_* variables too (TestMariaDBWithMySQLEnvVars)") callback {
            m, err = mariadb.run("mariadb:10.3.29") {
                scripts(["modules/mariadb/testdata/schema.sql"])
                tc.env("MARIADB_AUTO_UPGRADE", "1")
            }
            if m != null { testing.cleanup_container(m.container) }
            spec.assert_ok(err, "mariadb starts")
            if err == "" {
                name, serr = run_sql(m, "test", "test", "test", "SELECT name from profile")
                spec.assert_ok(serr, "SELECT")
                spec.assert_str_eq(name, "profile 1", "the script's row")
                envs = container_env(m.container)
                spec.assert_contains(envs, "\"MYSQL_USER=test\"", "MARIADB_USER mirrored")
                spec.assert_contains(envs, "\"MYSQL_DATABASE=test\"", "MARIADB_DATABASE mirrored")
                spec.assert_contains(envs, "\"MYSQL_AUTO_UPGRADE=1\"", "every MARIADB_* variable is mirrored, not only the module's")
            }
        }

        spec.it("starts from a config file (WithConfigFile)") callback {
            m, err = mariadb.run(IMAGE) {
                config_file("modules/mariadb/testdata/my.cnf")
            }
            if m != null { testing.cleanup_container(m.container) }
            spec.assert_ok(err, "mariadb starts")
            if err == "" {
                conf, cerr = tc.copy_file_from_container(m.container, "/etc/mysql/conf.d/my.cnf")
                spec.assert_ok(cerr, "the config file is in the container")
                spec.assert_contains(conf, "innodb_buffer_pool_size = 16M", "it is the file we gave")
                v, serr = run_sql(m, "test", "test", "test", "SELECT @@GLOBAL.innodb_buffer_pool_size, @@GLOBAL.innodb_lock_wait_timeout")
                spec.assert_ok(serr, "SELECT")
                spec.assert_contains(v, "16777216\t50", "the file's innodb_buffer_pool_size and lock wait timeout")
            }
        }
    }
    return spec.run_summary(fw)
}
