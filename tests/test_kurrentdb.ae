// Ported from testcontainers-go modules/kurrentdb/kurrentdb_test.go
//
// A real KurrentDB: the connection string says tls=false and its host:port
// answers the HTTP health endpoint (204) and /info (200, JSON).
// Not ported: the Go test's EventStore gRPC client append/read.

import std.spec
import std.string
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
 import modules.kurrentdb

// (status, body, error); headers are "Name: value" strings.
fn call_api(method: string, url: string, headers: string[], body: string, ctype: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 30s)
    for h in headers {
        colon = string.index_of(h, ":")
        client.set_header(req, string.substring(h, 0, colon), string.trim(string.substring(h, colon + 1, string.length(h))))
    }
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), ctype) }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    status = client.response_status(r)
    out = client.response_body(r)
    client.response_free(r)
    return status, out, ""
}

const IMAGE = "kurrentplatform/kurrentdb:26.1.1"

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/kurrentdb") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves HTTP at the connection string's address (TestKurrentDB)") callback {
            k, err = kurrentdb.run(IMAGE)
            if k != null { testing.cleanup_container(k.container) }
            spec.assert_ok(err, "kurrentdb starts")
            if err == "" {
                cs, cerr = kurrentdb.connection_string(k)
                spec.assert_ok(cerr, "connection string")
                spec.assert_true(string.starts_with(cs, "kurrentdb://localhost:") == 1, "kurrentdb:// URL: ${cs}")
                spec.assert_true(string.ends_with(cs, "?tls=false") == 1, "insecure: ${cs}")
                hostport = string.substring(cs, 12, string.length(cs) - 10)
                hs, _, herr = call_api("GET", "http://${hostport}/health/live", [], "", "")
                spec.assert_ok(herr, "GET /health/live")
                spec.assert_eq(hs, 204, "live is 204")
                is, ib, ierr = call_api("GET", "http://${hostport}/info", [], "", "")
                spec.assert_ok(ierr, "GET /info")
                spec.assert_eq(is, 200, "info is 200")
                spec.assert_contains(ib, "\"state\"", "info reports the node state")
            }
        }
    }
    return spec.run_summary(fw)
}
