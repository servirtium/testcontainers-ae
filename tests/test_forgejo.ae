// Ported from testcontainers-go modules/forgejo/forgejo_test.go
//
// A real Forgejo: /api/healthz answers 200 at the module's connection
// string, and the admin user the module creates (default and custom
// credentials) authenticates against /api/v1/user with HTTP Basic auth.

import std.spec
import std.string
import std.encoding
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.forgejo

const IMAGE = "codeberg.org/forgejo/forgejo:11"

// (status, body, error); user "" sends no Authorization.
fn get(url: string, user: string, pw: string) -> (int, string, string) {
    req = client.request("GET", url)
    client.set_timeout(req, 30s)
    if string.length(user) > 0 {
        client.set_header(req, "Authorization", "Basic ${encoding.base64_encode_padded(string.bytes("${user}:${pw}"))}")
    }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    body = client.response_body(r)
    client.response_free(r)
    return st, body, ""
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/forgejo") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("is healthy and has the default admin (TestForgejo)") callback {
            f, err = forgejo.run(IMAGE)
            testing.cleanup_container(f.container)
            spec.assert_ok(err, "forgejo starts")
            if err == "" {
                url, uerr = forgejo.connection_string(f)
                spec.assert_ok(uerr, "connection string")
                spec.assert_true(string.starts_with(url, "http://localhost:") == 1, "an http:// URL: ${url}")
                hs, _, herr = get("${url}/api/healthz", "", "")
                spec.assert_ok(herr, "GET /api/healthz")
                spec.assert_eq(hs, 200, "healthz is 200")
                spec.assert_str_eq(f.admin_username, "forgejo-admin", "default admin user")
                spec.assert_str_eq(f.admin_password, "forgejo-admin", "default admin password")
                us, ub, uerr2 = get("${url}/api/v1/user", f.admin_username, f.admin_password)
                spec.assert_ok(uerr2, "GET /api/v1/user")
                spec.assert_eq(us, 200, "the default admin authenticates: ${ub}")
                ssh, serr = forgejo.ssh_connection_string(f)
                spec.assert_ok(serr, "ssh connection string")
                spec.assert_contains(ssh, ":", "host:port")
            }
        }

        spec.it("creates the admin with custom credentials (TestForgejoWithAdminCredentials)") callback {
            f, err = forgejo.run(IMAGE) {
                admin_credentials("testuser", "testpassword", "test@example.com")
            }
            testing.cleanup_container(f.container)
            spec.assert_ok(err, "forgejo starts")
            if err == "" {
                spec.assert_str_eq(f.admin_username, "testuser", "admin user")
                url, _ = forgejo.connection_string(f)
                us, ub, uerr = get("${url}/api/v1/user", "testuser", "testpassword")
                spec.assert_ok(uerr, "GET /api/v1/user")
                spec.assert_eq(us, 200, "the custom admin authenticates: ${ub}")
                spec.assert_contains(ub, "test@example.com", "with the given email")
                ds, _, derr = get("${url}/api/v1/user", "forgejo-admin", "forgejo-admin")
                spec.assert_ok(derr, "default admin request")
                spec.assert_eq(ds, 401, "the default admin does not exist")
            }
        }

        spec.it("refuses bad options (WithAdminCredentials, WithConfig)") callback {
            f, err = forgejo.run(IMAGE) { admin_credentials("u", "", "e@x") }
            spec.assert_contains(err, "must not be empty", "empty password")
            f2, err2 = forgejo.run(IMAGE) { config("a__b", "k", "v") }
            spec.assert_contains(err2, "must not contain", "double underscore")
        }
    }
    return spec.run_summary(fw)
}
