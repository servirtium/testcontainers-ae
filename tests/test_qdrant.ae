// Ported from testcontainers-go modules/qdrant/qdrant_test.go
//
// A real Qdrant: GET /healthz, then an HTTP PUT that creates a collection
// and a GET that reads it back, over the mapped REST port.

import std.spec
import std.string
import std.http.client
import std.tcp
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.qdrant

const IMAGE = "qdrant/qdrant:v1.7.4"

// One HTTP request: (status, body, error).
fn http_do(method: string, url: string, body: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 10s)
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "application/json") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    b = client.response_body(r)
    client.response_free(r)
    return st, b, ""
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/qdrant") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves REST: health and a collection (TestQdrant)") callback {
            c, err = qdrant.run(IMAGE)
            testing.cleanup_container(c)
            spec.assert_ok(err, "qdrant starts")
            if err != "" { return }
            rest, rerr = qdrant.rest_endpoint(c)
            spec.assert_ok(rerr, "rest endpoint")
            spec.assert_true(string.starts_with(rest, "http://") == 1, "an http:// URL: ${rest}")
            st, _b, herr = http_do("GET", "${rest}/healthz", "")
            spec.assert_ok(herr, "GET /healthz")
            spec.assert_eq(st, 200, "healthz status")
            put_st, put_body, perr = http_do("PUT", "${rest}/collections/tcae", "{\"vectors\":{\"size\":4,\"distance\":\"Dot\"}}")
            spec.assert_ok(perr, "PUT /collections/tcae")
            spec.assert_eq(put_st, 200, "create collection: ${put_body}")
            gst, gbody, gerr = http_do("GET", "${rest}/collections/tcae", "")
            spec.assert_ok(gerr, "GET collection")
            spec.assert_eq(gst, 200, "collection exists")
            spec.assert_contains(gbody, "\"status\":\"green\"", "collection is green: ${gbody}")
        }

        spec.it("reports REST, gRPC and web UI endpoints (TestQdrant)") callback {
            c, err = qdrant.run(IMAGE)
            testing.cleanup_container(c)
            spec.assert_ok(err, "qdrant starts")
            if err != "" { return }
            rp, _ = tc.mapped_port(c, qdrant.REST_PORT)
            gp, _ = tc.mapped_port(c, qdrant.GRPC_PORT)
            rest, _ = qdrant.rest_endpoint(c)
            grpc, _ = qdrant.grpc_endpoint(c)
            ui, _ = qdrant.web_ui(c)
            spec.assert_str_eq(rest, "http://localhost:${rp}", "REST endpoint shape")
            spec.assert_str_eq(grpc, "localhost:${gp}", "gRPC endpoint shape")
            spec.assert_str_eq(ui, "http://localhost:${rp}/dashboard", "web UI shape")
            // the gRPC port really accepts connections
            sock, cerr = tcp.connect("localhost", gp)
            spec.assert_ok(cerr, "gRPC port accepts a connection")
            if cerr == "" { tcp.tcp_close(sock) }
            st, _b, herr = http_do("GET", ui, "")
            spec.assert_ok(herr, "GET /dashboard")
            spec.assert_true(st == 200 || st == 404, "dashboard answers (${st})")
        }

        spec.it("mixes core options into the block") callback {
            c, err = qdrant.run(IMAGE) {
                tc.env("QDRANT__LOG_LEVEL", "WARN")
                tc.env("TCAE_MARK", "qdrant")
            }
            testing.cleanup_container(c)
            spec.assert_ok(err, "qdrant starts")
            if err == "" {
                _c, out, eerr = tc.exec(c, ["printenv", "TCAE_MARK"])
                spec.assert_ok(eerr, "exec")
                spec.assert_str_eq(string.trim(out), "qdrant", "the core env setter reached the request")
            }
        }
    }
    return spec.run_summary(fw)
}
