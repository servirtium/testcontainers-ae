// Ported from testcontainers-go modules/cassandra/cassandra_test.go
//
// A real Cassandra: TestCassandra's connection (connection_host is the CQL
// port) is proved by a native-protocol OPTIONS -> SUPPORTED exchange over
// std.tcp, and TestCassandraWithInitScripts by the keyspaces the .cql and .sh
// init scripts create, read back with cqlsh in the container. (There is no CQL
// client in std; Go's gocql queries are not ported.)

import std.spec
import std.string
import std.tcp
import std.bytes
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.cassandra

const IMAGE = "cassandra:4.1.3"

fn put(buf: ptr, v: int) { bytes.set(buf, bytes.length(buf), v) }

// Read exactly n bytes as hex text.
fn read_hex(sock: ptr, n: int) -> (string, string) {
    buf = bytes.new(n + 16)
    got = 0
    tries = 0
    out = ""
    while got < n && tries < 200 {
        cv = bytes.capacity_view(buf)
        m, rerr = tcp.read_into(sock, cv[got..n])
        if rerr != "" && rerr != "timeout" { bytes.free(buf); return "", rerr }
        got = got + m
        tries = tries + 1
    }
    if got < n { bytes.free(buf); return "", "short read: ${got} of ${n} bytes" }
    v = bytes.capacity_view(buf)
    i = 0
    hexd = "0123456789abcdef"
    while i < n {
        d = v[i] & 255
        out = "${out}${string.substring(hexd, d / 16, d / 16 + 1)}${string.substring(hexd, d % 16, d % 16 + 1)}"
        i = i + 1
    }
    bytes.free(buf)
    return out, ""
}

// One CQL native-protocol v4 exchange: OPTIONS (opcode 0x05, stream 0, no
// body) must be answered by a SUPPORTED (0x06) response frame (version 0x84).
// Returns the 9-byte response header as hex.
fn cql_options(host: string, port: int) -> (string, string) {
    sock, cerr = tcp.connect(host, port)
    if cerr != "" { return "", cerr }
    req = bytes.new(16)
    put(req, 4)
    put(req, 0)
    put(req, 0)
    put(req, 0)
    put(req, 5)
    put(req, 0)
    put(req, 0)
    put(req, 0)
    put(req, 0)
    _, werr = tcp.write_all(sock, bytes.view(req))
    bytes.free(req)
    if werr != "" { tcp.tcp_close(sock); return "", werr }
    hdr, rerr = read_hex(sock, 9)
    tcp.tcp_close(sock)
    return hdr, rerr
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/cassandra") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("speaks CQL at the connection host and runs init scripts (TestCassandra, TestCassandraWithInitScripts)") callback {
            c, err = cassandra.run(IMAGE) {
                init_script("modules/cassandra/testdata/init.cql")
                init_script("modules/cassandra/testdata/init.sh")
            }
            testing.cleanup_container(c)
            spec.assert_ok(err, "cassandra starts")
            if err == "" {
                hp, herr = cassandra.connection_host(c)
                spec.assert_ok(herr, "connection host")
                spec.assert_true(string.starts_with(hp, "localhost:") == 1, "host:port: ${hp}")
                h, _ = tc.host(c)
                port, perr = tc.mapped_port(c, cassandra.PORT)
                spec.assert_ok(perr, "mapped port")
                hdr, terr = cql_options(h, port)
                spec.assert_ok(terr, "OPTIONS round trip")
                spec.assert_str_eq(string.substring(hdr, 0, 2), "84", "a v4 response frame")
                spec.assert_str_eq(string.substring(hdr, 8, 10), "06", "opcode SUPPORTED")

                code, out, xerr = tc.exec(c, ["cqlsh", "-e", "SELECT name FROM test_keyspace.test_table; SELECT name FROM init_sh_keyspace.test_table"])
                spec.assert_ok(xerr, "exec")
                spec.assert_eq(code, 0, "both keyspaces exist: ${out}")
                spec.assert_contains(out, "NAME", "the rows the scripts inserted")
            }
        }
    }
    return spec.run_summary(fw)
}
