// Ported from testcontainers-go modules/s3mock/s3mock_test.go
//
// A real S3Mock: endpoint_url() lists the initial buckets over the S3 REST
// API (XML), an object is PUT into one and read back, and the HTTPS endpoint
// URL has the https scheme. Not ported: the AWS SDK client calls.

import std.spec
import std.string
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
 import modules.s3mock

// (status, body, error); headers are "Name: value" strings.
fn call_api(method: string, url: string, headers: string[], body: string, ctype: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 30s)
    for h in headers {
        colon = string.index_of(h, ":")
        client.set_header(req, string.substring(h, 0, colon), string.trim(string.substring(h, colon + 1, string.length(h))))
    }
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), ctype) }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    status = client.response_status(r)
    out = client.response_body(r)
    client.response_free(r)
    return status, out, ""
}

const IMAGE = "adobe/s3mock:3.9.1"

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/s3mock") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves S3 with initial buckets (TestS3Mock_WithInitialBuckets)") callback {
            c, err = s3mock.run(IMAGE) {
                initial_buckets(["bucket-a", "bucket-b"])
            }
            testing.cleanup_container(c)
            spec.assert_ok(err, "s3mock starts")
            if err == "" {
                url, uerr = s3mock.endpoint_url(c)
                spec.assert_ok(uerr, "endpoint url")
                spec.assert_true(string.starts_with(url, "http://localhost:") == 1, "http:// URL: ${url}")
                surl, serr = s3mock.https_endpoint_url(c)
                spec.assert_ok(serr, "https endpoint url")
                spec.assert_true(string.starts_with(surl, "https://localhost:") == 1, "https:// URL: ${surl}")

                ls, lb, le = call_api("GET", "${url}/", [], "", "")
                spec.assert_ok(le, "list buckets")
                spec.assert_eq(ls, 200, "ListBuckets is 200")
                spec.assert_contains(lb, "<Name>bucket-a</Name>", "bucket-a exists")
                spec.assert_contains(lb, "<Name>bucket-b</Name>", "bucket-b exists")

                ps, _, pe = call_api("PUT", "${url}/bucket-a/hello.txt", [], "hello s3mock", "text/plain")
                spec.assert_ok(pe, "PutObject")
                spec.assert_eq(ps, 200, "PutObject is 200")
                gs, gb, ge = call_api("GET", "${url}/bucket-a/hello.txt", [], "", "")
                spec.assert_ok(ge, "GetObject")
                spec.assert_eq(gs, 200, "GetObject is 200")
                spec.assert_str_eq(gb, "hello s3mock", "the object reads back")
            }
        }
    }
    return spec.run_summary(fw)
}
