// Ported from testcontainers-go modules/arangodb/arangodb_test.go
//
// A real ArangoDB: with root_password() set, credentials() returns it, the
// HTTP endpoint answers /_api/version to those credentials and refuses an
// anonymous or wrong-password request.

import std.spec
import std.string
import std.encoding
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.arangodb

const IMAGE = "arangodb:3.11.5"

// One HTTP request: (status, body, error). hdrs are "Name: value" lines.
fn http_do(method: string, url: string, hdrs: string[], body: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 30s)
    for h in hdrs {
        colon = string.index_of(h, ":")
        client.set_header(req, string.substring(h, 0, colon), string.trim(string.substring(h, colon + 1, string.length(h))))
    }
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "application/json") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    b = client.response_body(r)
    client.response_free(r)
    return st, b, ""
}

fn basic(user: string, pw: string) -> string {
    return "Authorization: Basic ${encoding.base64_encode_padded(string.bytes("${user}:${pw}"))}"
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/arangodb") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("authenticates the root password (TestArangoDB)") callback {
            a, err = arangodb.run(IMAGE) { root_password("s3cret") }
            if a != null { testing.cleanup_container(a.container) }
            spec.assert_ok(err, "arangodb starts")
            if err == "" {
                user, pw = arangodb.credentials(a)
                spec.assert_str_eq(user, "root", "user")
                spec.assert_str_eq(pw, "s3cret", "password")
                url, uerr = arangodb.http_endpoint(a)
                spec.assert_ok(uerr, "http endpoint")
                spec.assert_true(string.starts_with(url, "http://localhost:") == 1, "an http URL: ${url}")
                st, body, herr = http_do("GET", "${url}/_api/version", [basic(user, pw)], "")
                spec.assert_ok(herr, "GET /_api/version")
                spec.assert_eq(st, 200, "authenticated")
                spec.assert_contains(body, "arango", "the server answers: ${body}")
                an, _ab, aerr = http_do("GET", "${url}/_api/version", [], "")
                spec.assert_ok(aerr, "anonymous request")
                spec.assert_eq(an, 401, "anonymous is refused")
                wr, _wb, werr = http_do("GET", "${url}/_api/version", [basic("root", "root")], "")
                spec.assert_ok(werr, "wrong password")
                spec.assert_eq(wr, 401, "the default password is refused")
            }
        }
    }
    return spec.run_summary(fw)
}
