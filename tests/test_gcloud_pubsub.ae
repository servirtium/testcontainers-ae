// Ported from testcontainers-go modules/gcloud/examples/pubsub/examples_test.go (ExampleRun)
//
// Compile-checked only. The engine-free case checks the module's request
// defaults, option and helper output for real. The case that starts the
// emulator runs only with TCAE_LIVE_PUBSUB=1 and an engine.

import std.spec
import std.string
import std.os
import std.http.client
import std.tcp
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.gcloud.pubsub

const IMAGE = "gcr.io/google.com/cloudsdktool/cloud-sdk:emulators"

// 1 when TCAE_LIVE_PUBSUB=1 and an engine answers. The variable is read first
// so that nothing touches an engine unless asked to.
fn live_on() -> int {
    if string.length(os.os_getenv("TCAE_LIVE_PUBSUB")) == 0 { return 0 }
    if os.os_getenv("TCAE_LIVE_PUBSUB") != "1" { return 0 }
    return testing.engine_ok()
}

// One HTTP request with an optional JSON body: (status, body, error).
fn http_do(method: string, url: string, body: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 30s)
    client.set_header(req, "Authorization", "Bearer owner")
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "application/json") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    b = client.response_body(r)
    client.response_free(r)
    return st, b, ""
}

main() {
    fw = spec.init()
    live = live_on()

    spec.describe(fw, "modules/gcloud/pubsub") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("has the module's defaults and options (engine-free)") callback {
            r = pubsub.pubsub_request_new()
            spec.assert_str_eq(tc.req_setting(r, "pubsub.project_id"), "test-project", "default project id")
            exposed = tc.req_exposed(r)
            spec.assert_true(exposed.len >= 1, "ports are exposed")
            spec.assert_str_eq(exposed[0], pubsub.PORT, "the emulator port")
            pubsub.project_id(r, "pubsub-project")
            spec.assert_str_eq(tc.req_setting(r, "pubsub.project_id"), "pubsub-project", "project_id replaces it")
            cmd = pubsub.emulator_command("pubsub-project")
            spec.assert_eq(cmd.len, 3, "sh -c <line>")
            spec.assert_contains(cmd[2], "gcloud beta emulators pubsub start --host-port 0.0.0.0:8085 --project=pubsub-project", "the emulator command")
            spec.assert_str_eq(pubsub.emulator_env_entry("localhost:1234"), "PUBSUB_EMULATOR_HOST=localhost:1234", "emulator env entry")
            pubsub.pubsub_request_free(r)
        }

        spec.it_when(live, "starts the emulator (ExampleRun)", "set TCAE_LIVE_PUBSUB=1 and have an engine") callback {
            g, err = pubsub.run(IMAGE) {
                project_id("pubsub-project")
            }
            if g != null { testing.cleanup_container(g.container) }
            spec.assert_ok(err, "pubsub starts")
            if err != "" { return }
            spec.assert_true(tc.is_running(g.container), "container is running")

            // ExampleRun: a topic, a subscription, one message published and pulled
            // (Go's example does it with the pubsub SDK over gRPC; the emulator
            // answers the REST API on the same port)
            base = "http://${pubsub.uri(g)}/v1/projects/${pubsub.project_id_of(g)}"
            spec.assert_str_eq(pubsub.project_id_of(g), "pubsub-project", "project id")
            st, _b, herr = http_do("PUT", "${base}/topics/greetings", "{}")
            spec.assert_ok(herr, "create topic")
            spec.assert_eq(st, 200, "topic created")
            st2, _b2, herr2 = http_do("PUT", "${base}/subscriptions/subscription", "{\"topic\":\"projects/pubsub-project/topics/greetings\"}")
            spec.assert_ok(herr2, "create subscription")
            spec.assert_eq(st2, 200, "subscription created")
            st3, _b3, herr3 = http_do("POST", "${base}/topics/greetings:publish", "{\"messages\":[{\"data\":\"SGVsbG8gV29ybGQ=\"}]}")
            spec.assert_ok(herr3, "publish")
            spec.assert_eq(st3, 200, "published")
            st4, body4, herr4 = http_do("POST", "${base}/subscriptions/subscription:pull", "{\"maxMessages\":1,\"returnImmediately\":true}")
            spec.assert_ok(herr4, "pull")
            spec.assert_eq(st4, 200, "pulled")
            spec.assert_contains(body4, "SGVsbG8gV29ybGQ=", "Hello World comes back")
        }
    }
    return spec.run_summary(fw)
}
