// Ported from testcontainers-go modules/chroma/chroma_test.go
//
// A real Chroma: GET /api/v2/heartbeat at rest_endpoint answers 200 with a
// nanosecond heartbeat, and /api/v2/version answers.

import std.spec
import std.string
import std.http.client
import std.tcp
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.chroma

const IMAGE = "chromadb/chroma:1.4.0"

// One HTTP request: (status, body, error).
fn http_do(method: string, url: string, body: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 15s)
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "application/json") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    b = client.response_body(r)
    client.response_free(r)
    return st, b, ""
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/chroma") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves the REST API (TestChroma)") callback {
            c, err = chroma.run(IMAGE)
            testing.cleanup_container(c)
            spec.assert_ok(err, "chroma starts")
            if err != "" { return }
            url, uerr = chroma.rest_endpoint(c)
            spec.assert_ok(uerr, "rest endpoint")
            spec.assert_true(string.starts_with(url, "http://") == 1, "an http:// URL: ${url}")
            st, body, herr = http_do("GET", "${url}/api/v2/heartbeat", "")
            spec.assert_ok(herr, "GET heartbeat")
            spec.assert_eq(st, 200, "heartbeat status")
            spec.assert_contains(body, "nanosecond heartbeat", "the heartbeat body")
            vs, vb, verr = http_do("GET", "${url}/api/v2/version", "")
            spec.assert_ok(verr, "GET version")
            spec.assert_eq(vs, 200, "version status")
            spec.assert_true(string.length(vb) > 0, "a version: ${vb}")
        }
    }
    return spec.run_summary(fw)
}
