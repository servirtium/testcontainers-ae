// Ported from go-sql-driver/mysql v1.9.3 packets_test.go (TestReadPacket*,
// TestRegression801), utils_test.go (TestLengthEncodedInteger,
// TestFormatBinaryDateTime, TestFormatBinaryTime, TestEscape*),
// dsn_test.go (testDSNs, TestDSNParserInvalid, TestDSNReformat,
// TestDSNServerPubKey, TestDSNWithCustomTLS, TestDSNTLSConfig,
// TestDSNUnsafeCollation, TestParamsAreSorted, TestNormalizeTLSConfig) and
// auth_test.go (the scrambles, TestAuthFast*, TestAuthSwitch*,
// TestOldAuthSwitch), with their vectors and captured bytes.
