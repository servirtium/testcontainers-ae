// Ported from testcontainers-go modules/yugabytedb/yugabytedb_test.go
//
// A real YugabyteDB: TestYugabyteDB_YSQL's connection string has the module's
// credentials, and the YSQL port answers a PostgreSQL SSLRequest (so it is
// the PostgreSQL protocol); TestYugabyteDB_YCQL's port answers a CQL
// native-protocol OPTIONS with SUPPORTED. Both over std.tcp (no pgx / gocql).

import std.spec
import std.string
import std.tcp
import std.bytes
import std.os
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.yugabytedb

const IMAGE = "yugabytedb/yugabyte:2024.1.3.0-b105"

fn put(buf: ptr, v: int) { bytes.set(buf, bytes.length(buf), v) }

// Read exactly n bytes as hex text.
fn read_hex(sock: ptr, n: int) -> (string, string) {
    buf = bytes.new(n + 16)
    got = 0
    tries = 0
    out = ""
    while got < n && tries < 200 {
        cv = bytes.capacity_view(buf)
        m, rerr = tcp.read_into(sock, cv[got..n])
        if rerr != "" && rerr != "timeout" { bytes.free(buf); return "", rerr }
        got = got + m
        tries = tries + 1
    }
    if got < n { bytes.free(buf); return "", "short read: ${got} of ${n} bytes" }
    v = bytes.capacity_view(buf)
    i = 0
    hexd = "0123456789abcdef"
    while i < n {
        d = v[i] & 255
        out = "${out}${string.substring(hexd, d / 16, d / 16 + 1)}${string.substring(hexd, d % 16, d % 16 + 1)}"
        i = i + 1
    }
    bytes.free(buf)
    return out, ""
}

// Send the bytes, read n back as hex.
fn exchange(host: string, port: int, req: ptr, n: int) -> (string, string) {
    sock, cerr = tcp.connect(host, port)
    if cerr != "" { bytes.free(req); return "", cerr }
    _, werr = tcp.write_all(sock, bytes.view(req))
    bytes.free(req)
    if werr != "" { tcp.tcp_close(sock); return "", werr }
    out, rerr = read_hex(sock, n)
    tcp.tcp_close(sock)
    return out, rerr
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }
    // Compile-checked only: on the Podman machine yugabyted needs more than
    // 90 s to start and the container was killed (exit 137) before the wait
    // strategy saw "YugabyteDB Started". Set TCAE_YUGABYTEDB=1 to run it anyway.
    if string.length(os.os_getenv("TCAE_YUGABYTEDB")) == 0 {
        println("SKIP modules/yugabytedb: compile-checked only (set TCAE_YUGABYTEDB=1 to run it live)")
        return spec.run_summary(fw)
    }

    spec.describe(fw, "modules/yugabytedb") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves YSQL and YCQL (TestYugabyteDB_YSQL, TestYugabyteDB_YCQL)") callback {
            y, err = yugabytedb.run(IMAGE) {
                database_name("app")
                database_user("appuser")
                database_password("secret")
            }
            if y != null { testing.cleanup_container(y.container) }
            spec.assert_ok(err, "yugabytedb starts")
            if err == "" {
                dsn, derr = yugabytedb.ysql_connection_string(y, ["sslmode=disable"])
                spec.assert_ok(derr, "ysql connection string")
                spec.assert_true(string.starts_with(dsn, "postgres://appuser:secret@localhost:") == 1, "dsn: ${dsn}")
                spec.assert_true(string.ends_with(dsn, "/app?sslmode=disable") == 1, "dsn: ${dsn}")

                h, _ = tc.host(y.container)
                pp, perr = tc.mapped_port(y.container, yugabytedb.YSQL_PORT)
                spec.assert_ok(perr, "ysql port")
                // PostgreSQL SSLRequest: length 8, code 80877103; the answer is 'S' or 'N'
                ssl = bytes.new(8)
                put(ssl, 0)
                put(ssl, 0)
                put(ssl, 0)
                put(ssl, 8)
                put(ssl, 4)
                put(ssl, 210)
                put(ssl, 22)
                put(ssl, 47)
                a, aerr = exchange(h, pp, ssl, 1)
                spec.assert_ok(aerr, "SSLRequest")
                spec.assert_true(a == "4e" || a == "53", "YSQL answers N or S to an SSLRequest: ${a}")

                cp, cerr = tc.mapped_port(y.container, yugabytedb.YCQL_PORT)
                spec.assert_ok(cerr, "ycql port")
                hp, hperr = yugabytedb.ycql_host(y)
                spec.assert_ok(hperr, "ycql host")
                spec.assert_str_eq(hp, "${h}:${cp}", "ycql host:port")
                opt = bytes.new(16)
                put(opt, 4)
                put(opt, 0)
                put(opt, 0)
                put(opt, 0)
                put(opt, 5)
                put(opt, 0)
                put(opt, 0)
                put(opt, 0)
                put(opt, 0)
                hdr, oerr = exchange(h, cp, opt, 9)
                spec.assert_ok(oerr, "OPTIONS")
                spec.assert_str_eq(string.substring(hdr, 0, 2), "84", "a v4 response frame")
                spec.assert_str_eq(string.substring(hdr, 8, 10), "06", "opcode SUPPORTED")
            }
        }
    }
    return spec.run_summary(fw)
}
