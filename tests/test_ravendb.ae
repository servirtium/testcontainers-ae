// Ported from testcontainers-go modules/ravendb/ravendb_test.go
//
// A real RavenDB: the management URL serves /build/version, the databases
// API answers without credentials (unsecured mode), and the TCP endpoint
// helper points at the mapped server port.

import std.spec
import std.string
import std.encoding
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.ravendb

const IMAGE = "ravendb/ravendb:6.0-ubuntu-latest"

// One HTTP request: (status, body, error). hdrs are "Name: value" lines.
fn http_do(method: string, url: string, hdrs: string[], body: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 30s)
    for h in hdrs {
        colon = string.index_of(h, ":")
        client.set_header(req, string.substring(h, 0, colon), string.trim(string.substring(h, colon + 1, string.length(h))))
    }
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "application/json") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    b = client.response_body(r)
    client.response_free(r)
    return st, b, ""
}

fn basic(user: string, pw: string) -> string {
    return "Authorization: Basic ${encoding.base64_encode_padded(string.bytes("${user}:${pw}"))}"
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/ravendb") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves the management API (TestRavenDB)") callback {
            c, err = ravendb.run(IMAGE)
            testing.cleanup_container(c)
            spec.assert_ok(err, "ravendb starts")
            if err == "" {
                url, uerr = ravendb.management_url(c)
                spec.assert_ok(uerr, "management url")
                spec.assert_true(string.starts_with(url, "http://localhost:") == 1, "an http URL: ${url}")
                st, body, herr = http_do("GET", "${url}/build/version", [], "")
                spec.assert_ok(herr, "GET /build/version")
                spec.assert_eq(st, 200, "version is 200")
                spec.assert_contains(body, "ProductVersion", "the version document: ${body}")
                ds, _db, derr = http_do("GET", "${url}/databases", [], "")
                spec.assert_ok(derr, "GET /databases")
                spec.assert_eq(ds, 200, "unsecured access is allowed")
                tcp, terr = ravendb.tcp_endpoint(c)
                spec.assert_ok(terr, "tcp endpoint")
                spec.assert_true(string.starts_with(tcp, "localhost:") == 1, "host:port: ${tcp}")
            }
        }
    }
    return spec.run_summary(fw)
}
