// Ported from testcontainers-go modules/milvus/milvus_test.go
//
// A real Milvus standalone (TestMilvus): /healthz on the HTTP port answers OK,
// and the gRPC port from connection_string accepts a TCP connection.

import std.spec
import std.string
import std.tcp
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.milvus

const IMAGE = "milvusdb/milvus:v2.3.9"

// (status, body, error) of a GET.
fn http_get(url: string) -> (int, string, string) {
    req = client.request("GET", url)
    client.set_timeout(req, 30s)
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    status = client.response_status(r)
    out = client.response_body(r)
    client.response_free(r)
    return status, out, ""
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/milvus") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("is healthy, and the connection string is the gRPC port (TestMilvus)") callback {
            c, err = milvus.run(IMAGE)
            testing.cleanup_container(c)
            spec.assert_ok(err, "milvus starts")
            if err == "" {
                addr, aerr = milvus.connection_string(c)
                spec.assert_ok(aerr, "connection string")
                grpc, _ = tc.endpoint(c, milvus.GRPC_PORT, "")
                spec.assert_str_eq(addr, grpc, "host:port of 19530")

                web, _ = tc.endpoint(c, milvus.HTTP_PORT, "http")
                st, body, herr = http_get("${web}/healthz")
                spec.assert_ok(herr, "GET /healthz")
                spec.assert_eq(st, 200, "healthz is 200")
                spec.assert_contains(body, "OK", "healthz says OK: ${body}")

                h, _ = tc.host(c)
                port, _ = tc.mapped_port(c, milvus.GRPC_PORT)
                sock, cerr = tcp.connect(h, port)
                spec.assert_ok(cerr, "the gRPC port accepts a connection at ${addr}")
                if cerr == "" { tcp.tcp_close(sock) }
            }
        }
    }
    return spec.run_summary(fw)
}
