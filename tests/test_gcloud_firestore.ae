// Ported from testcontainers-go modules/gcloud/examples/firestore/examples_test.go
// (ExampleRun, ExampleRun_datastoreMode)
//
// Compile-checked only. The engine-free cases check the module's request
// defaults, options and the emulator command for real. The cases that start
// the emulator run only with TCAE_LIVE_FIRESTORE=1 and an engine.

import std.spec
import std.string
import std.os
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.gcloud.firestore

const IMAGE = "gcr.io/google.com/cloudsdktool/cloud-sdk:emulators"

// 1 when TCAE_LIVE_FIRESTORE=1 and an engine answers. The variable is read first
// so that nothing touches an engine unless asked to.
fn live_on() -> int {
    if os.getenv("TCAE_LIVE_FIRESTORE") != "1" { return 0 }
    return testing.engine_ok()
}

// One HTTP request with an optional JSON body: (status, body, error).
fn http_do(method: string, url: string, body: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 30s)
    client.set_header(req, "Authorization", "Bearer owner")
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "application/json") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    b = client.response_body(r)
    client.response_free(r)
    return st, b, ""
}

main() {
    fw = spec.init()
    live = live_on()

    spec.describe(fw, "modules/gcloud/firestore") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("has the module's defaults and options (engine-free)") callback {
            r = firestore.firestore_request_new()
            spec.assert_str_eq(tc.req_setting(r, "firestore.project_id"), "test-project", "default project id")
            exposed = tc.req_exposed(r)
            spec.assert_eq(exposed.len, 1, "one port")
            spec.assert_str_eq(exposed[0], "8080/tcp", "the emulator port")
            firestore.project_id(r, "firestore-project")
            spec.assert_str_eq(tc.req_setting(r, "firestore.project_id"), "firestore-project", "project_id replaces it")
            spec.assert_false(tc.req_has_setting(r, "firestore.datastore_mode"), "not in datastore mode")
            firestore.datastore_mode(r)
            spec.assert_true(tc.req_has_setting(r, "firestore.datastore_mode"), "datastore_mode is recorded")
            spec.assert_str_eq(firestore.emulator_env_entry("localhost:1234"), "FIRESTORE_EMULATOR_HOST=localhost:1234", "emulator env entry")
            firestore.firestore_request_free(r)
        }

        spec.it("builds the emulator command (engine-free)") callback {
            plain = firestore.emulator_command("p1", false)
            spec.assert_eq(plain.len, 3, "sh -c <line>")
            spec.assert_str_eq(plain[2], "gcloud beta emulators firestore start --host-port 0.0.0.0:8080 --project=p1", "plain command")
            ds = firestore.emulator_command("p1", true)
            spec.assert_str_eq(ds[2], "gcloud beta emulators firestore start --host-port 0.0.0.0:8080 --project=p1 --database-mode=datastore-mode", "datastore mode command")
        }

        spec.it_when(live, "starts the emulator and stores a document (ExampleRun)", "set TCAE_LIVE_FIRESTORE=1 and have an engine") callback {
            g, err = firestore.run(IMAGE) {
                project_id("firestore-project")
            }
            if g != null { testing.cleanup_container(g.container) }
            spec.assert_ok(err, "firestore starts")
            if err != "" { return }
            spec.assert_str_eq(firestore.project_id_of(g), "firestore-project", "project id")
            // the example creates users/alovelace with the Firestore SDK over gRPC;
            // the emulator answers the REST API on the same port
            docs = "http://${firestore.uri(g)}/v1/projects/firestore-project/databases/(default)/documents"
            doc = "{\"fields\":{\"firstname\":{\"stringValue\":\"Ada\"},\"lastname\":{\"stringValue\":\"Lovelace\"}}}"
            st, _b, herr = http_do("POST", "${docs}/users?documentId=alovelace", doc)
            spec.assert_ok(herr, "create document")
            spec.assert_eq(st, 200, "created")
            st2, body2, herr2 = http_do("GET", "${docs}/users/alovelace", "")
            spec.assert_ok(herr2, "get document")
            spec.assert_eq(st2, 200, "got it")
            spec.assert_contains(body2, "Ada", "firstname")
            spec.assert_contains(body2, "Lovelace", "lastname")
        }

        spec.it_when(live, "starts in datastore mode (ExampleRun_datastoreMode)", "set TCAE_LIVE_FIRESTORE=1 and have an engine") callback {
            g, err = firestore.run(IMAGE) {
                project_id("firestore-project")
                datastore_mode()
            }
            if g != null { testing.cleanup_container(g.container) }
            spec.assert_ok(err, "firestore in datastore mode starts")
            if err != "" { return }
            spec.assert_true(tc.is_running(g.container), "container is running")
            // datastore mode serves the Datastore REST API on the emulator port
            st, _b, herr = http_do("POST", "http://${firestore.uri(g)}/v1/projects/firestore-project:lookup", "{\"keys\":[{\"path\":[{\"kind\":\"Task\",\"name\":\"none\"}]}]}")
            spec.assert_ok(herr, "datastore lookup")
            spec.assert_eq(st, 200, "datastore API answers")
        }
    }
    return spec.run_summary(fw)
}
