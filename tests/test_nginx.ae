// Ported from testcontainers-go modules/nginx/nginx_test.go
//
// A real nginx: GET / answers 200 with the stock page, a file copied in
// through the core's file_content is served, and each config option is shown
// to be in force by a location only that config defines.

import std.spec
import std.string
import std.http.client
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.nginx

const IMAGE = "nginx:1.25"

fn get(base: string, path: string) -> (int, string, string) {
    req = client.request("GET", "${base}${path}")
    client.set_timeout(req, 10s)
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    status = client.response_status(r)
    body = client.response_body(r)
    client.response_free(r)
    return status, body, ""
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/nginx") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves the stock page and a copied-in file (TestNginx)") callback {
            c, err = nginx.run(IMAGE) {
                tc.file_content("served by tcae\n", "/usr/share/nginx/html/tcae.txt", 420)
            }
            testing.cleanup_container(c)
            spec.assert_ok(err, "nginx starts")
            if err == "" {
                base, eerr = nginx.http_endpoint(c)
                spec.assert_ok(eerr, "http endpoint")
                spec.assert_true(string.starts_with(base, "http://localhost:") == 1, "an http:// URL: ${base}")
                status, body, herr = get(base, "/")
                spec.assert_ok(herr, "GET /")
                spec.assert_eq(status, 200, "GET / is 200")
                spec.assert_contains(body, "Welcome to nginx!", "the stock page")
                s2, b2, e2 = get(base, "/tcae.txt")
                spec.assert_ok(e2, "GET /tcae.txt")
                spec.assert_eq(s2, 200, "the copied file is served")
                spec.assert_str_eq(b2, "served by tcae\n", "with the content we gave")
                s3, _, _ = get(base, "/missing")
                spec.assert_eq(s3, 404, "a missing path is 404")
            }
        }

        spec.it("shapes the https endpoint") callback {
            c, err = nginx.run(IMAGE)
            testing.cleanup_container(c)
            spec.assert_ok(err, "nginx starts")
            if err == "" {
                u, uerr = nginx.https_endpoint(c)
                spec.assert_ok(uerr, "https endpoint")
                p, _ = tc.mapped_port(c, nginx.HTTPS_PORT)
                spec.assert_str_eq(u, "https://localhost:${p}", "https://host:mapped 443")
            }
        }

        spec.it("replaces nginx.conf (TestNginxWithConfigFile)") callback {
            c, err = nginx.run(IMAGE) {
                config_file("modules/nginx/testdata/whoami-nginx.conf")
            }
            testing.cleanup_container(c)
            spec.assert_ok(err, "nginx starts")
            if err == "" {
                base, _ = nginx.http_endpoint(c)
                status, body, herr = get(base, "/whoami")
                spec.assert_ok(herr, "GET /whoami")
                spec.assert_eq(status, 200, "the location from the given nginx.conf")
                spec.assert_str_eq(body, "main nginx.conf", "its body")
            }
        }

        spec.it("accepts Go's testdata/nginx.conf and default.conf (TestNginxWithConfigFile, TestNginxWithCustomConfig)") callback {
            c, err = nginx.run(IMAGE) {
                config_file("modules/nginx/testdata/nginx.conf")
            }
            testing.cleanup_container(c)
            spec.assert_ok(err, "nginx starts with Go's nginx.conf")
            if err == "" {
                base, _ = nginx.http_endpoint(c)
                status, _, herr = get(base, "/")
                spec.assert_ok(herr, "GET /")
                spec.assert_eq(status, 200, "GET / is 200")
            }
            c2, err2 = nginx.run(IMAGE) {
                custom_config("modules/nginx/testdata/default.conf")
            }
            testing.cleanup_container(c2)
            spec.assert_ok(err2, "nginx starts with Go's default.conf")
            if err2 == "" {
                base2, _ = nginx.http_endpoint(c2)
                s2, _, e2 = get(base2, "/")
                spec.assert_ok(e2, "GET /")
                spec.assert_eq(s2, 200, "GET / is 200")
            }
        }

        spec.it("replaces conf.d/default.conf (TestNginxWithCustomConfig)") callback {
            c, err = nginx.run(IMAGE) {
                custom_config("modules/nginx/testdata/ping.conf")
            }
            testing.cleanup_container(c)
            spec.assert_ok(err, "nginx starts")
            if err == "" {
                base, _ = nginx.http_endpoint(c)
                status, body, herr = get(base, "/ping")
                spec.assert_ok(herr, "GET /ping")
                spec.assert_eq(status, 200, "the location from the given default.conf")
                spec.assert_str_eq(body, "pong from default.conf", "its body")
                s2, _, _ = get(base, "/")
                spec.assert_eq(s2, 404, "the stock page is gone")
            }
        }
    }
    return spec.run_summary(fw)
}
