// Ported from testcontainers-go modules/timeplus/timeplus_test.go
//
// A real timeplusd: GET /timeplusd/ping at http_endpoint answers 200, and a
// SELECT 1 posted to the ClickHouse-style HTTP interface returns 1.

import std.spec
import std.string
import std.http.client
import std.tcp
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.timeplus

const IMAGE = "timeplus/timeplusd:2.3.37"

// One HTTP request: (status, body, error).
fn http_do(method: string, url: string, body: string) -> (int, string, string) {
    req = client.request(method, url)
    client.set_timeout(req, 15s)
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "application/json") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    st = client.response_status(r)
    b = client.response_body(r)
    client.response_free(r)
    return st, b, ""
}

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/timeplus") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves HTTP (TestTimeplus/http endpoint)") callback {
            c, err = timeplus.run(IMAGE)
            testing.cleanup_container(c)
            spec.assert_ok(err, "timeplusd starts")
            if err != "" { return }
            url, uerr = timeplus.http_endpoint(c)
            spec.assert_ok(uerr, "http endpoint")
            spec.assert_true(string.starts_with(url, "http://") == 1, "an http:// URL: ${url}")
            st, _b, herr = http_do("GET", "${url}/timeplusd/ping", "")
            spec.assert_ok(herr, "GET ping")
            spec.assert_eq(st, 200, "ping status")
            qs, qb, qerr = http_do("POST", "${url}/?default_format=TabSeparated", "SELECT 1")
            spec.assert_ok(qerr, "POST SELECT 1")
            spec.assert_eq(qs, 200, "query status: ${qb}")
            spec.assert_str_eq(string.trim(qb), "1", "SELECT 1 is 1")
        }
    }
    return spec.run_summary(fw)
}
