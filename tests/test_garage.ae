// Ported from testcontainers-go modules/garage/garage_test.go
//
// A real Garage: the S3 API at the module's connection_string is called with
// AWS Signature V4 (signed with std.cryptography's HMAC-SHA256): the default
// bucket is listed with the module's credentials and region, a PUT/GET of an
// object round-trips, and a wrong secret is refused (403). Go's test uses the
// AWS SDK, which has no Aether counterpart.

import std.spec
import std.string
import std.http.client
import std.cryptography
import std.time
import testcontainers as tc
import testcontainers.docker
import testcontainers.testing
import modules.garage

const IMAGE = "dxflrs/garage:v2.4.1"

fn hmac_raw(key: string, msg: string) -> string {
    d, _, _ = cryptography.hmac_sha256_bytes(string.bytes(key), string.bytes(msg))
    return d
}

fn hmac_hex(key: string, msg: string) -> string {
    h, _ = cryptography.hmac_sha256_hex(string.bytes(key), string.bytes(msg))
    return h
}

// A signed S3 request (path-style): (status, body, error).
fn s3(method: string, hostport: string, path: string, body: string, access: string, secret: string, region: string) -> (int, string, string) {
    now = time.now()
    amz_date = time.strftime(now, "%Y%m%dT%H%M%SZ")
    day = time.strftime(now, "%Y%m%d")
    payload, _ = cryptography.sha256_hex(string.bytes(body))
    scope = "${day}/${region}/s3/aws4_request"
    signed = "host;x-amz-content-sha256;x-amz-date"
    canon = "${method}\n${path}\n\nhost:${hostport}\nx-amz-content-sha256:${payload}\nx-amz-date:${amz_date}\n\n${signed}\n${payload}"
    ch, _ = cryptography.sha256_hex(string.bytes(canon))
    to_sign = "AWS4-HMAC-SHA256\n${amz_date}\n${scope}\n${ch}"
    k1 = hmac_raw("AWS4${secret}", day)
    k2 = hmac_raw(k1, region)
    k3 = hmac_raw(k2, "s3")
    k4 = hmac_raw(k3, "aws4_request")
    sig = hmac_hex(k4, to_sign)
    req = client.request(method, "http://${hostport}${path}")
    client.set_timeout(req, 10s)
    client.set_header(req, "x-amz-date", amz_date)
    client.set_header(req, "x-amz-content-sha256", payload)
    client.set_header(req, "Authorization", "AWS4-HMAC-SHA256 Credential=${access}/${scope}, SignedHeaders=${signed}, Signature=${sig}")
    if string.length(body) > 0 { client.set_body(req, string.bytes(body), "text/plain") }
    r, err = client.send_request(req)
    client.request_free(req)
    if err != "" { return 0, "", err }
    status = client.response_status(r)
    out = client.response_body(r)
    client.response_free(r)
    return status, out, ""
}

fn hostport_of(url: string) -> string { return string.substring(url, 7, string.length(url)) }

main() {
    fw = spec.init()
    if testing.skip_if_no_engine(fw) == 1 { return spec.run_summary(fw) }

    spec.describe(fw, "modules/garage") {
        spec.after_each() callback { testing.cleanup_all() }

        spec.it("serves the default bucket with the default credentials (defaults)") callback {
            g, err = garage.run(IMAGE)
            testing.cleanup_container(g.container)
            spec.assert_ok(err, "garage starts")
            if err == "" {
                spec.assert_str_eq(g.access_key, "testcontainers", "default access key")
                spec.assert_str_eq(g.secret_key, "testcontainers-secret", "default secret key")
                spec.assert_str_eq(g.bucket, "testcontainers", "default bucket")
                spec.assert_str_eq(g.region, "garage", "default region")
                url, uerr = garage.connection_string(g)
                spec.assert_ok(uerr, "connection string")
                spec.assert_true(string.starts_with(url, "http://localhost:") == 1, "an http:// URL: ${url}")
                hp = hostport_of(url)

                ls, lb, lerr = s3("GET", hp, "/testcontainers", "", g.access_key, g.secret_key, g.region)
                spec.assert_ok(lerr, "ListObjects")
                spec.assert_eq(ls, 200, "the default bucket is listable: ${lb}")
                spec.assert_contains(lb, "testcontainers", "the bucket's own listing")

                ps, pb, perr = s3("PUT", hp, "/testcontainers/hello.txt", "hello garage", g.access_key, g.secret_key, g.region)
                spec.assert_ok(perr, "PutObject")
                spec.assert_eq(ps, 200, "PutObject is 200: ${pb}")
                gs, gb, gerr = s3("GET", hp, "/testcontainers/hello.txt", "", g.access_key, g.secret_key, g.region)
                spec.assert_ok(gerr, "GetObject")
                spec.assert_eq(gs, 200, "GetObject is 200")
                spec.assert_str_eq(gb, "hello garage", "the object reads back")

                bs, _, berr = s3("GET", hp, "/testcontainers", "", g.access_key, "a-wrong-secret-key-0000", g.region)
                spec.assert_ok(berr, "wrong secret request")
                spec.assert_eq(bs, 403, "a wrong secret is refused")
            }
        }

        spec.it("takes credentials, bucket and region (custom)") callback {
            g, err = garage.run(IMAGE) {
                credentials("custom-access", "custom-secret-key")
                bucket("custom-bucket")
                region("eu-west-1")
            }
            testing.cleanup_container(g.container)
            spec.assert_ok(err, "garage starts")
            if err == "" {
                spec.assert_str_eq(g.access_key, "custom-access", "access key")
                spec.assert_str_eq(g.bucket, "custom-bucket", "bucket")
                spec.assert_str_eq(g.region, "eu-west-1", "region")
                url, _ = garage.connection_string(g)
                ls, lb, lerr = s3("GET", hostport_of(url), "/custom-bucket", "", "custom-access", "custom-secret-key", "eu-west-1")
                spec.assert_ok(lerr, "ListObjects")
                spec.assert_eq(ls, 200, "the custom bucket is listable with the custom credentials and region: ${lb}")
            }
        }

        spec.it("refuses short credentials and an empty region") callback {
            g, err = garage.run(IMAGE) { credentials("short", "tiny") }
            spec.assert_true(err != "", "short credentials are an error")
            spec.assert_contains(err, "access key must be at least 8 bytes", "the reason")
            g2, err2 = garage.run(IMAGE) { region("") }
            spec.assert_contains(err2, "region must not be empty", "an empty region is refused")
        }
    }
    return spec.run_summary(fw)
}
