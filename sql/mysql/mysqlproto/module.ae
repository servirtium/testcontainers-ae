// Ported from go-sql-driver/mysql v1.9.3 const.go, errors.go, fields.go,
// utils.go, collations.go (the default collation, a few common ones and the
// unsafe list), packets.go (the encodings and decodings of the packets, not
// their I/O) and auth.go (the password scrambles and the RSA encryption of
// the password).
// Copyright 2012 The Go-MySQL-Driver Authors. All rights reserved.
// (const.go, packets.go and utils.go 2012; errors.go 2013; collations.go
// 2014; fields.go 2017; auth.go 2018.)
//
// This Source Code Form is subject to the terms of the Mozilla Public
// License, v. 2.0. If a copy of the MPL was not distributed with this file,
// You can obtain one at http://mozilla.org/MPL/2.0/.
//
// Modifications: ported to Aether by the testcontainers-ae contributors.
//
// sql.mysql.mysqlproto: the MySQL client/server protocol's bytes, as pure
// functions over byte[] with no I/O: the constants, the 3-byte packet
// header, length-encoded integers and strings, the handshake v10 packet,
// OK/ERR/EOF packets, column definitions, text and binary result rows,
// COM_STMT_EXECUTE's body, the password scrambles of mysql_native_password,
// caching_sha2_password and mysql_old_password, and the RSA-OAEP (SHA-1)
// encryption of the password for caching_sha2_password / sha256_password.
// sql.mysql.mysqlconn does the I/O.
//
// Go returns driver.Values of several types from a row; here every value is
// the text database/sql would convert it to (sql keeps text, DESIGN.md
// section 14): integers in decimal, FLOAT and DOUBLE as strconv's shortest
// 'g' form, DATE/DATETIME/TIMESTAMP/TIME as MySQL's text (Go's default
// without parseTime), DECIMAL and strings as sent, blobs as their bytes.
//
// RSA: std.cryptography.rsa has OAEP with SHA-256 only, and MySQL (like Go's
// rsa.EncryptOAEP(sha1.New(), ...)) uses OAEP with SHA-1 and MGF1-SHA-1, so
// encrypt_password builds the OAEP block here (RFC 8017 section 7.1.1) and
// uses rsa.raw_encrypt for m^e mod n. The server's key arrives as a PEM
// "PUBLIC KEY" (SubjectPublicKeyInfo), read with std.cryptography.pem and
// asn1.

import std.string
import std.bytes
import std.mem
import std.cryptography
import std.cryptography.sha1
import std.cryptography.sha2
import std.cryptography.rsa
import std.cryptography.pem
import std.cryptography.asn1
import sql

exports(
    Buf, Field, MySQLError, OkPacket, Handshake, Row,
    // const.go
    DEFAULT_AUTH_PLUGIN, DEFAULT_MAX_ALLOWED_PACKET, MIN_PROTOCOL_VERSION, MAX_PACKET_SIZE,
    I_OK, I_AUTH_MORE_DATA, I_LOCAL_INFILE, I_EOF, I_ERR,
    CLIENT_LONG_PASSWORD, CLIENT_FOUND_ROWS, CLIENT_LONG_FLAG, CLIENT_CONNECT_WITH_DB,
    CLIENT_NO_SCHEMA, CLIENT_COMPRESS, CLIENT_ODBC, CLIENT_LOCAL_FILES, CLIENT_IGNORE_SPACE,
    CLIENT_PROTOCOL41, CLIENT_INTERACTIVE, CLIENT_SSL, CLIENT_IGNORE_SIGPIPE,
    CLIENT_TRANSACTIONS, CLIENT_RESERVED, CLIENT_SECURE_CONN, CLIENT_MULTI_STATEMENTS,
    CLIENT_MULTI_RESULTS, CLIENT_PS_MULTI_RESULTS, CLIENT_PLUGIN_AUTH, CLIENT_CONNECT_ATTRS,
    CLIENT_PLUGIN_AUTH_LEN_ENC_CLIENT_DATA, CLIENT_CAN_HANDLE_EXPIRED_PASSWORDS,
    CLIENT_SESSION_TRACK, CLIENT_DEPRECATE_EOF,
    COM_QUIT, COM_INIT_DB, COM_QUERY, COM_PING, COM_STMT_PREPARE, COM_STMT_EXECUTE,
    COM_STMT_SEND_LONG_DATA, COM_STMT_CLOSE, COM_STMT_RESET,
    FIELD_TYPE_DECIMAL, FIELD_TYPE_TINY, FIELD_TYPE_SHORT, FIELD_TYPE_LONG, FIELD_TYPE_FLOAT,
    FIELD_TYPE_DOUBLE, FIELD_TYPE_NULL, FIELD_TYPE_TIMESTAMP, FIELD_TYPE_LONGLONG,
    FIELD_TYPE_INT24, FIELD_TYPE_DATE, FIELD_TYPE_TIME, FIELD_TYPE_DATETIME, FIELD_TYPE_YEAR,
    FIELD_TYPE_NEWDATE, FIELD_TYPE_VARCHAR, FIELD_TYPE_BIT, FIELD_TYPE_VECTOR,
    FIELD_TYPE_JSON, FIELD_TYPE_NEWDECIMAL, FIELD_TYPE_ENUM, FIELD_TYPE_SET,
    FIELD_TYPE_TINY_BLOB, FIELD_TYPE_MEDIUM_BLOB, FIELD_TYPE_LONG_BLOB, FIELD_TYPE_BLOB,
    FIELD_TYPE_VAR_STRING, FIELD_TYPE_STRING, FIELD_TYPE_GEOMETRY,
    FLAG_NOT_NULL, FLAG_PRI_KEY, FLAG_UNIQUE_KEY, FLAG_BLOB, FLAG_UNSIGNED, FLAG_BINARY,
    FLAG_ENUM, FLAG_AUTO_INCREMENT, FLAG_SET,
    STATUS_IN_TRANS, STATUS_IN_AUTOCOMMIT, STATUS_MORE_RESULTS_EXISTS,
    STATUS_NO_BACKSLASH_ESCAPES,
    CACHING_SHA2_REQUEST_PUBLIC_KEY, CACHING_SHA2_FAST_AUTH_SUCCESS,
    CACHING_SHA2_PERFORM_FULL_AUTHENTICATION,
    DEFAULT_COLLATION_ID, BINARY_COLLATION_ID,
    // errors.go
    ERR_INVALID_CONN, ERR_MALFORM_PKT, ERR_NO_TLS, ERR_CLEARTEXT_PASSWORD,
    ERR_NATIVE_PASSWORD, ERR_OLD_PASSWORD, ERR_UNKNOWN_PLUGIN, ERR_OLD_PROTOCOL,
    ERR_PKT_SYNC, ERR_PKT_SYNC_MUL, ERR_PKT_TOO_LARGE, ERR_BAD_CONN_NO_WRITE, ERR_SKIP,
    mysql_error_string, error_number,
    // collations.go
    collation_id, is_unsafe_collation,
    // byte helpers (utils.go)
    new_buf, buf_bytes, put_u8, put_u16, put_u32, put_u64, put_raw, put_str,
    get_uint24, put_uint24, get_u16, get_u32, get_u64, index_byte, copy_range,
    read_length_encoded_integer, read_length_encoded_string, skip_length_encoded_string,
    append_length_encoded_integer, append_length_encoded_string, read_bool,
    uint64_to_string, format_binary_datetime, format_binary_time, format_float,
    float32_from_bits, escape_backslash, escape_quotes, interpolate_params,
    // packets.go (decoding)
    parse_handshake, parse_error_packet, parse_ok_packet, read_status, is_eof_packet,
    parse_column, decode_text_row, decode_binary_row, new_row, prepare_ok,
    execute_packet, long_data_packet,
    // fields.go
    type_database_name,
    // auth.go
    scramble_password, scramble_sha256_password, scramble_old_password,
    encrypt_password, parse_pkix_public_key, oaep_sha1_pad
)

