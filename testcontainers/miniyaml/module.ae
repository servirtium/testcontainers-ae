// testcontainers.miniyaml: the YAML a compose file is written in, read in
// pure Aether.
//
//     import testcontainers.miniyaml
//
//     d, err = miniyaml.parse(text)
//     svcs = miniyaml.lookup(d, miniyaml.root(d), "services")
//     n = miniyaml.size(d, svcs)
//     name = miniyaml.key(d, svcs, 0)
//     body = miniyaml.value(d, svcs, 0)
//
// Why it exists: std.yaml is backed by libfyaml, an OPTIONAL build
// dependency, and the released Aether toolchains (0.889.0 on macOS and on
// Linux) are built without it, so every std.yaml call returns "std.yaml
// unavailable: this build has no libfyaml" however many libfyaml packages
// the machine has installed. modules/compose only reads compose files (the
// service names and their profiles, the networks and volumes) and the test
// reads back the override it writes, so a reader that needs no C library
// gives the same answer on every host.
//
// The subset it reads is what compose files use: block mappings and
// sequences (including a mapping inside a "- " item and a sequence at its
// key's indent), flow [a, b] and {k: v}, plain, 'single' and "double" quoted
// scalars, | and > block scalars (kept as text), # comments, "---" and
// "..." markers, and &anchor / !tag prefixes (dropped). Aliases, merge keys
// and complex (non-scalar) keys are not resolved: *x reads as the text
// "*x" and << as a key named "<<". Mapping keys are scalars.
//
// Nodes are integers (-1 for none), owned by the document; free(d) once.

import std.string

exports(
    Doc, parse, free, root, kind, scalar, size, key, value, item, lookup,
    SCALAR, MAPPING, SEQUENCE
)

const SCALAR = 0
const MAPPING = 1
const SEQUENCE = 2

struct Doc {
    // The lines that carry content: indent, text (comment and trailing
    // blanks gone), raw (as written, for block scalars).
    lind: int[]
    ltext: string[]
    lraw: string[]
    pos: int
    // The nodes: kind, scalar text, the key in the parent mapping, first
    // and last child, next sibling.
    nkind: int[]
    ntext: string[]
    nkey: string[]
    nfirst: int[]
    nlast: int[]
    nnext: int[]
    // The flow text being read and the position in it.
    fs: string
    fp: int
    root: int
}

// ---- lines -----------------------------------------------------------

// text without a trailing comment: a # at the start or after a blank, outside quotes.
fn strip_comment(s: string) -> string {
    n = string.length(s)
    q = 0
    i = 0
    while i < n {
        c = string.char_at(s, i)
        if q == 0 {
            if c == 34 || c == 39 {
                // a quote opens a quoted scalar only at the start of a token
                if i == 0 { q = c } else {
                    p = string.char_at(s, i - 1)
                    if p == 32 || p == 58 || p == 45 || p == 91 || p == 123 || p == 44 { q = c }
                }
            } else if c == 35 {
                if i == 0 { return "" }
                p = string.char_at(s, i - 1)
                if p == 32 || p == 9 { return string.substring(s, 0, i) }
            }
        } else if q == 34 && c == 92 {
            i = i + 1
        } else if c == q {
            q = 0
        }
        i = i + 1
    }
    return s
}

fn indent_of(s: string) -> int {
    n = string.length(s)
    i = 0
    while i < n && string.char_at(s, i) == 32 { i = i + 1 }
    return i
}

fn trim_right(s: string) -> string {
    n = string.length(s)
    while n > 0 {
        c = string.char_at(s, n - 1)
        if c == 32 || c == 9 || c == 13 { n = n - 1 } else { return string.substring(s, 0, n) }
    }
    return ""
}

fn load_lines(d: *Doc, text: string) {
    parts = string.split(text, "\n")
    n = string.string_array_size(parts)
    i = 0
    while i < n {
        raw = trim_right(string.string_array_get(parts, i))
        t = trim_right(strip_comment(raw))
        ind = indent_of(t)
        body = string.substring(t, ind, string.length(t))
        if string.length(body) > 0 && body != "---" && body != "..." && !string.starts_with(body, "%") {
            d.lind.push(ind)
            d.ltext.push(body)
            d.lraw.push(raw)
        }
        i = i + 1
    }
    string.string_array_free(parts)
}

// ---- nodes -----------------------------------------------------------

fn new_node(d: *Doc, k: int, text: string) -> int {
    d.nkind.push(k)
    d.ntext.push(text)
    d.nkey.push("")
    d.nfirst.push(-1)
    d.nlast.push(-1)
    d.nnext.push(-1)
    return d.nkind.len - 1
}

fn add_child(d: *Doc, parent: int, child: int, k: string) {
    d.nkey[child] = k
    if d.nlast[parent] < 0 { d.nfirst[parent] = child } else { d.nnext[d.nlast[parent]] = child }
    d.nlast[parent] = child
}

// ---- scalars ---------------------------------------------------------

// A quoted scalar starting at s[0], and where it ended.
fn quoted_end(s: string) -> int {
    q = string.char_at(s, 0)
    n = string.length(s)
    i = 1
    while i < n {
        c = string.char_at(s, i)
        if q == 34 && c == 92 { i = i + 2 } else if c == q {
            if q == 39 && i + 1 < n && string.char_at(s, i + 1) == 39 { i = i + 2 } else { return i }
        } else { i = i + 1 }
    }
    return n
}

fn unquote(s: string) -> string {
    n = string.length(s)
    if n == 0 { return "" }
    q = string.char_at(s, 0)
    if q != 34 && q != 39 { return s }
    e = quoted_end(s)
    inner = string.substring(s, 1, e)
    if q == 39 { return string.replace_all(inner, "''", "'") }
    out = ""
    m = string.length(inner)
    i = 0
    while i < m {
        c = string.char_at(inner, i)
        if c == 92 && i + 1 < m {
            i = i + 1
            e2 = string.char_at(inner, i)
            if e2 == 110 { out = "${out}\n" } else if e2 == 116 { out = "${out}\t" } else { out = "${out}${string.from_char(e2)}" }
        } else {
            out = "${out}${string.from_char(c)}"
        }
        i = i + 1
    }
    return out
}

// An &anchor or !tag prefix dropped from a value.
fn drop_props(v: string) -> string {
    t = v
    while string.length(t) > 0 {
        c = string.char_at(t, 0)
        if c != 38 && c != 33 { return t }
        sp = string.index_of(t, " ")
        if sp < 0 { return "" }
        t = string.trim(string.substring(t, sp, string.length(t)))
    }
    return t
}

// ---- flow ------------------------------------------------------------

fn flow_ws(d: *Doc) {
    n = string.length(d.fs)
    while d.fp < n {
        c = string.char_at(d.fs, d.fp)
        if c == 32 || c == 9 || c == 10 || c == 13 { d.fp = d.fp + 1 } else { return }
    }
}

fn flow_scalar(d: *Doc, stop_colon: bool) -> string {
    n = string.length(d.fs)
    flow_ws(d)
    c0 = string.char_at(d.fs, d.fp)
    if d.fp < n && (c0 == 34 || c0 == 39) {
        rest = string.substring(d.fs, d.fp, n)
        e = quoted_end(rest)
        tok = string.substring(rest, 0, e + 1)
        d.fp = d.fp + e + 1
        return unquote(tok)
    }
    st = d.fp
    while d.fp < n {
        c = string.char_at(d.fs, d.fp)
        if c == 44 || c == 93 || c == 125 { break }
        if stop_colon && c == 58 {
            nx = 32
            if d.fp + 1 < n { nx = string.char_at(d.fs, d.fp + 1) }
            if nx == 32 || nx == 44 || nx == 93 || nx == 125 { break }
        }
        d.fp = d.fp + 1
    }
    return string.trim(string.substring(d.fs, st, d.fp))
}

fn flow_value(d: *Doc) -> int {
    n = string.length(d.fs)
    flow_ws(d)
    if d.fp >= n { return new_node(d, SCALAR, "") }
    c = string.char_at(d.fs, d.fp)
    if c == 91 {
        node = new_node(d, SEQUENCE, "")
        d.fp = d.fp + 1
        while d.fp < n {
            flow_ws(d)
            if d.fp >= n { break }
            if string.char_at(d.fs, d.fp) == 93 { d.fp = d.fp + 1; break }
            before = d.fp
            add_child(d, node, flow_value(d), "")
            flow_ws(d)
            if d.fp < n && string.char_at(d.fs, d.fp) == 44 { d.fp = d.fp + 1 }
            if d.fp == before { d.fp = d.fp + 1 }
        }
        return node
    }
    if c == 123 {
        node = new_node(d, MAPPING, "")
        d.fp = d.fp + 1
        while d.fp < n {
            flow_ws(d)
            if d.fp >= n { break }
            if string.char_at(d.fs, d.fp) == 125 { d.fp = d.fp + 1; break }
            before = d.fp
            k = flow_scalar(d, true)
            flow_ws(d)
            v = -1
            if d.fp < n && string.char_at(d.fs, d.fp) == 58 {
                d.fp = d.fp + 1
                v = flow_value(d)
            } else {
                v = new_node(d, SCALAR, "")
            }
            add_child(d, node, v, k)
            flow_ws(d)
            if d.fp < n && string.char_at(d.fs, d.fp) == 44 { d.fp = d.fp + 1 }
            if d.fp == before { d.fp = d.fp + 1 }
        }
        return node
    }
    return new_node(d, SCALAR, flow_scalar(d, false))
}

// A value written on one line: flow collection or scalar.
fn inline_value(d: *Doc, v: string) -> int {
    t = drop_props(v)
    if string.length(t) == 0 { return new_node(d, SCALAR, "") }
    c = string.char_at(t, 0)
    if c == 91 || c == 123 {
        d.fs = t
        d.fp = 0
        return flow_value(d)
    }
    return new_node(d, SCALAR, unquote(t))
}

// ---- blocks ----------------------------------------------------------

// The ':' that ends a mapping key on this line, or -1.
fn key_colon(t: string) -> int {
    n = string.length(t)
    if n == 0 { return -1 }
    c0 = string.char_at(t, 0)
    if c0 == 91 || c0 == 123 { return -1 }
    i = 0
    if c0 == 34 || c0 == 39 { i = quoted_end(t) + 1 }
    while i < n {
        c = string.char_at(t, i)
        if c == 58 {
            if i + 1 >= n { return i }
            if string.char_at(t, i + 1) == 32 { return i }
        }
        i = i + 1
    }
    return -1
}

fn is_seq_line(t: string) -> bool {
    return t == "-" || string.starts_with(t, "- ")
}

// The block scalar that follows a | or > line at indent ind, as text.
fn block_scalar(d: *Doc, ind: int) -> int {
    out = ""
    while d.pos < d.lind.len && d.lind[d.pos] > ind {
        raw = d.lraw[d.pos]
        line = string.trim(raw)
        if string.length(out) > 0 { out = "${out}\n" }
        out = "${out}${line}"
        d.pos = d.pos + 1
    }
    return new_node(d, SCALAR, out)
}

fn skip_deeper(d: *Doc, ind: int) {
    while d.pos < d.lind.len && d.lind[d.pos] > ind { d.pos = d.pos + 1 }
}

fn parse_block(d: *Doc, min_indent: int) -> int {
    if d.pos >= d.lind.len || d.lind[d.pos] < min_indent { return new_node(d, SCALAR, "") }
    ind = d.lind[d.pos]
    t = d.ltext[d.pos]
    if is_seq_line(t) { return parse_seq(d, ind) }
    if key_colon(t) >= 0 { return parse_map(d, ind) }
    d.pos = d.pos + 1
    node = inline_value(d, t)
    skip_deeper(d, ind)
    return node
}

fn parse_seq(d: *Doc, ind: int) -> int {
    node = new_node(d, SEQUENCE, "")
    while d.pos < d.lind.len && d.lind[d.pos] == ind && is_seq_line(d.ltext[d.pos]) {
        t = d.ltext[d.pos]
        rest = string.trim(string.substring(t, 1, string.length(t)))
        child = -1
        if string.length(rest) == 0 {
            d.pos = d.pos + 1
            if d.pos < d.lind.len && d.lind[d.pos] > ind {
                child = parse_block(d, ind + 1)
            } else {
                child = new_node(d, SCALAR, "")
            }
        } else {
            // the item's own line becomes the first line of a block at its column
            off = string.length(t) - string.length(rest)
            d.lind[d.pos] = ind + off
            d.ltext[d.pos] = rest
            child = parse_block(d, ind + off)
        }
        add_child(d, node, child, "")
    }
    return node
}

fn parse_map(d: *Doc, ind: int) -> int {
    node = new_node(d, MAPPING, "")
    while d.pos < d.lind.len && d.lind[d.pos] == ind && !is_seq_line(d.ltext[d.pos]) {
        t = d.ltext[d.pos]
        ci = key_colon(t)
        if ci < 0 { break }
        k = unquote(string.trim(string.substring(t, 0, ci)))
        v = drop_props(string.trim(string.substring(t, ci + 1, string.length(t))))
        child = -1
        if string.length(v) == 0 {
            d.pos = d.pos + 1
            if d.pos < d.lind.len && d.lind[d.pos] > ind {
                child = parse_block(d, ind + 1)
            } else if d.pos < d.lind.len && d.lind[d.pos] == ind && is_seq_line(d.ltext[d.pos]) {
                child = parse_seq(d, ind)
            } else {
                child = new_node(d, SCALAR, "")
            }
        } else if string.char_at(v, 0) == 124 || string.char_at(v, 0) == 62 {
            d.pos = d.pos + 1
            child = block_scalar(d, ind)
        } else {
            d.pos = d.pos + 1
            child = inline_value(d, v)
            skip_deeper(d, ind)
        }
        add_child(d, node, child, k)
    }
    return node
}

// ---- API -------------------------------------------------------------

// Read text: (*Doc, error). The error is "" or says which line could not
// be read.
parse(text: string) -> (*Doc, string) {
    d = heap.new(Doc)
    load_lines(d, text)
    d.root = parse_block(d, 0)
    if d.pos < d.lind.len {
        return d, "line text not understood: ${d.ltext[d.pos]}"
    }
    return d, ""
}

free(d: *Doc) { heap.free(d) }

root(d: *Doc) -> int { return d.root }

// SCALAR, MAPPING or SEQUENCE; -1 for no node.
kind(d: *Doc, n: int) -> int {
    if n < 0 { return -1 }
    return d.nkind[n]
}

// A scalar's text; "" for anything else.
scalar(d: *Doc, n: int) -> string {
    if n < 0 || d.nkind[n] != SCALAR { return "" }
    return d.ntext[n]
}

// Entries of a mapping or items of a sequence.
size(d: *Doc, n: int) -> int {
    if n < 0 || d.nkind[n] == SCALAR { return 0 }
    c = d.nfirst[n]
    k = 0
    while c >= 0 {
        k = k + 1
        c = d.nnext[c]
    }
    return k
}

fn child_at(d: *Doc, n: int, i: int) -> int {
    if n < 0 || d.nkind[n] == SCALAR { return -1 }
    c = d.nfirst[n]
    while c >= 0 && i > 0 {
        c = d.nnext[c]
        i = i - 1
    }
    return c
}

// The i'th key of a mapping.
key(d: *Doc, n: int, i: int) -> string {
    c = child_at(d, n, i)
    if c < 0 || d.nkind[n] != MAPPING { return "" }
    return d.nkey[c]
}

// The i'th value of a mapping.
value(d: *Doc, n: int, i: int) -> int {
    if n < 0 || d.nkind[n] != MAPPING { return -1 }
    return child_at(d, n, i)
}

// The i'th item of a sequence.
item(d: *Doc, n: int, i: int) -> int {
    if n < 0 || d.nkind[n] != SEQUENCE { return -1 }
    return child_at(d, n, i)
}

// A mapping's value for k (the last, if repeated), or -1.
lookup(d: *Doc, n: int, k: string) -> int {
    if n < 0 || d.nkind[n] != MAPPING { return -1 }
    found = -1
    c = d.nfirst[n]
    while c >= 0 {
        if d.nkey[c] == k { found = c }
        c = d.nnext[c]
    }
    return found
}
