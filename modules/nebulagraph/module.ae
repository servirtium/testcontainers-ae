// Ported from testcontainers-go modules/nebulagraph/nebulagraph.go, options.go
// and activator.sh
//
// modules.nebulagraph: a NebulaGraph cluster: metad, graphd, storaged and an
// "activator" (nebula-console) container that registers the storage host,
// all on one network, as Go's RunCluster. graphd and metad wait for their
// HTTP /status, storaged for its registration line, the activator for
// "Storage activated".
//
//     import modules.nebulagraph
//
//     cl, err = nebulagraph.run_cluster(
//         "vesoft/nebula-graphd:v3.8.0", "vesoft/nebula-storaged:v3.8.0",
//         "vesoft/nebula-metad:v3.8.0")
//     defer nebulagraph.terminate(cl)
//     addr, _ = nebulagraph.connection_string(cl)     // graphd "localhost:32771"
//
// The embedded activator.sh is Go's script verbatim (as a heredoc).
//
// Differences from Go: a Go caller passes a list of ContainerCustomizers per
// node; a builder takes one block, so run_cluster runs the defaults only, and
// run_cluster_with takes up to three prepared requests (null = the default),
// built with graphd_request_new() etc. and extended with tc setters; the
// network and aliases are attached by run_cluster_with, which owns the
// requests. Go's Terminate leaves the activator container to the reaper;
// terminate here removes it too.

import std.string
import testcontainers as tc
import testcontainers.wait
import testcontainers.docker
import testcontainers.network

exports(
    NebulaCluster, run_cluster, run_cluster_with, connection_string, terminate,
    graphd_request_new, metad_request_new, storaged_request_new,
    graphd_request_free, metad_request_free, storaged_request_free,
    GRAPHD_PORT, METAD_PORT, STORAGED_PORT, GRAPHD_HTTP_PORT, METAD_HTTP_PORT,
    STORAGED_HTTP_PORT, CONSOLE_IMAGE
)

const USER = "root"
const CONSOLE_IMAGE = "vesoft/nebula-console:v3.8.0"

const METAD_ALIAS = "metad0"
const GRAPHD_ALIAS = "graphd0"
const STORAGED_ALIAS = "storaged0"

const GRAPHD_PORT = "9669/tcp"
const METAD_PORT = "9559/tcp"
const STORAGED_PORT = "9779/tcp"
const GRAPHD_HTTP_PORT = "19669/tcp"
const METAD_HTTP_PORT = "19559/tcp"
const STORAGED_HTTP_PORT = "19779/tcp"

const ACTIVATOR_SCRIPT = <<SH
for i in $(seq 1 ${ACTIVATOR_RETRY}); do
echo "nebula" | nebula-console -addr graphd0 -port 9669 -u root -e 'ADD HOSTS "storaged0":9779' 1>/dev/null 2>/dev/null
if [ $? -eq 0 ]; then
	echo "✔️ Storage activated successfully."
	exit 0
else
	output=$(echo "nebula" | nebula-console -addr graphd0 -port 9669 -u root -e 'ADD HOSTS "storaged0":9779' 2>&1)
	if echo "$output" | grep -q "Existed"; then
		echo "✔️ Storage activated already , Exiting..."
		exit 0
	fi
fi
if [ $i -lt ${ACTIVATOR_RETRY} ]; then
	echo "⏳ Attempting to activate storaged, attempt $i/${ACTIVATOR_RETRY}... It's normal to take some attempts before storaged is ready. Please wait."
else
	echo "❌ Failed to activate storaged after ${ACTIVATOR_RETRY} attempts. Please check MetaD, StorageD logs."
	echo "ℹ️ Error during storage activation:"
	echo "=============================================================="
	echo "$output"
	echo "=============================================================="
	exit 1
fi
sleep 5
				done && tail -f /dev/null
SH

struct NebulaCluster {
    graphd: *docker.Container
    metad: *docker.Container
    storaged: *docker.Container
    activator: *docker.Container
    net: *docker.Network
}

fn common_args(r: ptr) {
    tc.cmd_arg(r, "--logtostderr=true")
    tc.cmd_arg(r, "--redirect_stdout=false")
    tc.cmd_arg(r, "--v=0")
    tc.cmd_arg(r, "--minloglevel=0")
}

graphd_request_new() -> ptr {
    r = tc.request_new()
    tc.expose(r, GRAPHD_PORT)
    tc.expose(r, GRAPHD_HTTP_PORT)
    tc.cmd_arg(r, "--meta_server_addrs=${METAD_ALIAS}:9559")
    tc.cmd_arg(r, "--port=9669")
    tc.cmd_arg(r, "--local_ip=${GRAPHD_ALIAS}")
    tc.cmd_arg(r, "--ws_ip=${GRAPHD_ALIAS}")
    tc.cmd_arg(r, "--ws_http_port=19669")
    common_args(r)
    tc.env(r, "USER", USER)
    tc.wait_for(r, wait.for_http("/status") { with_port(GRAPHD_HTTP_PORT); with_status(200) })
    return r
}
graphd_request_free(p: ptr) { tc.request_free(p) }

metad_request_new() -> ptr {
    r = tc.request_new()
    tc.expose(r, METAD_PORT)
    tc.expose(r, METAD_HTTP_PORT)
    tc.cmd_arg(r, "--meta_server_addrs=${METAD_ALIAS}:9559")
    tc.cmd_arg(r, "--local_ip=${METAD_ALIAS}")
    tc.cmd_arg(r, "--ws_ip=${METAD_ALIAS}")
    tc.cmd_arg(r, "--port=9559")
    tc.cmd_arg(r, "--ws_http_port=19559")
    tc.cmd_arg(r, "--data_path=/data/meta")
    common_args(r)
    tc.env(r, "USER", USER)
    tc.wait_for(r, wait.for_http("/status") { with_port(METAD_HTTP_PORT); with_status(200) })
    return r
}
metad_request_free(p: ptr) { tc.request_free(p) }

storaged_request_new() -> ptr {
    r = tc.request_new()
    tc.expose(r, STORAGED_PORT)
    tc.expose(r, STORAGED_HTTP_PORT)
    tc.cmd_arg(r, "--meta_server_addrs=${METAD_ALIAS}:9559")
    tc.cmd_arg(r, "--local_ip=${STORAGED_ALIAS}")
    tc.cmd_arg(r, "--ws_ip=${STORAGED_ALIAS}")
    tc.cmd_arg(r, "--port=9779")
    tc.cmd_arg(r, "--ws_http_port=19779")
    tc.cmd_arg(r, "--data_path=/data/storage")
    common_args(r)
    tc.env(r, "USER", USER)
    tc.wait_for(r, wait.for_log("localhost = \"${STORAGED_ALIAS}\":9779") { with_startup_timeout(30s) })
    return r
}
storaged_request_free(p: ptr) { tc.request_free(p) }

fn activator_request(net_name: string) -> ptr {
    r = tc.request_new()
    tc.entrypoint(r, [])
    tc.cmd(r, ["sh", "-c", ACTIVATOR_SCRIPT])
    tc.env(r, "USER", USER)
    tc.env(r, "ACTIVATOR_RETRY", "30")
    tc.wait_for(r, wait.for_log("✔️ Storage activated") { with_startup_timeout(60s) })
    tc.with_network(r, net_name)
    return r
}

fn attach(r: ptr, net_name: string, alias: string) {
    tc.with_network(r, net_name)
    tc.network_alias(r, net_name, alias)
}

// Go's terminate helper: the containers, then the network.
terminate(cl: *NebulaCluster) -> string {
    if cl == null { return "" }
    errs = ""
    if cl.activator != null { e = tc.terminate(cl.activator); if e != "" { errs = "${errs}terminate activator: ${e}; " } }
    if cl.storaged != null { e = tc.terminate(cl.storaged); if e != "" { errs = "${errs}terminate storaged: ${e}; " } }
    if cl.graphd != null { e = tc.terminate(cl.graphd); if e != "" { errs = "${errs}terminate graphd: ${e}; " } }
    if cl.metad != null { e = tc.terminate(cl.metad); if e != "" { errs = "${errs}terminate metad: ${e}; " } }
    if cl.net != null {
        e = network.remove(cl.net)
        if e != "" { errs = "${errs}network remove: ${e}; " }
    }
    return errs
}

// Go's RunCluster with prepared requests: metad, then graphd, then storaged,
// then the activator; a null request means the default. Requests are owned
// (consumed) by the call. On a failure the cluster so far is returned with
// the error so the caller can terminate it.
run_cluster_with(
    graphd_img: string, graphd_req: ptr,
    storaged_img: string, storaged_req: ptr,
    metad_img: string, metad_req: ptr
) -> (*NebulaCluster, string) {
    gr = graphd_req
    sr = storaged_req
    mr = metad_req
    if gr == null { gr = graphd_request_new() }
    if sr == null { sr = storaged_request_new() }
    if mr == null { mr = metad_request_new() }

    cl = heap.new(NebulaCluster)
    n, nerr = network.new_random()
    if nerr != "" {
        tc.request_free(gr)
        tc.request_free(sr)
        tc.request_free(mr)
        return null, "new nebulagraph network: ${nerr}"
    }
    cl.net = n

    attach(mr, n.name, METAD_ALIAS)
    mc, merr = tc.run_request(mr, metad_img)
    cl.metad = mc
    if merr != "" {
        tc.request_free(gr)
        tc.request_free(sr)
        return cl, "run metad container: ${merr}"
    }

    // graphd before storaged: needed for storage registration
    attach(gr, n.name, GRAPHD_ALIAS)
    gc, gerr = tc.run_request(gr, graphd_img)
    cl.graphd = gc
    if gerr != "" {
        tc.request_free(sr)
        return cl, "run graphd container: ${gerr}"
    }

    attach(sr, n.name, STORAGED_ALIAS)
    sc, serr = tc.run_request(sr, storaged_img)
    cl.storaged = sc
    if serr != "" { return cl, "run storaged container: ${serr}" }

    // registers storaged with retries; leaves the container running
    ac, aerr = tc.run_request(activator_request(n.name), CONSOLE_IMAGE)
    cl.activator = ac
    if aerr != "" { return cl, "run activator container: ${aerr}" }
    st, sterr = tc.state_of(ac)
    if sterr != "" { return cl, "get activator container state: ${sterr}" }
    if !st.running && st.exit_code != 0 {
        return cl, "activator container not running or exited with code ${st.exit_code}"
    }
    return cl, ""
}

// Go's RunCluster with the default customizers for all three nodes.
run_cluster(graphd_img: string, storaged_img: string, metad_img: string) -> (*NebulaCluster, string) {
    return run_cluster_with(graphd_img, null, storaged_img, null, metad_img, null)
}

// "host:port" of graphd (Go's ConnectionString).
connection_string(cl: *NebulaCluster) -> (string, string) {
    return tc.endpoint(cl.graphd, GRAPHD_PORT, "")
}
