// Ported from testcontainers-go modules/gcloud/pubsub/pubsub.go and options.go
// (WithProjectID is internal/shared/shared.go's)
//
// modules.gcloud.pubsub: the Google Cloud Pubsub emulator.
//
//     import modules.gcloud.pubsub
//
//     c, err = pubsub.run("gcr.io/google.com/cloudsdktool/cloud-sdk:emulators") {
//         project_id("pubsub-project")
//     }
//     defer pubsub.terminate(c)
//     pubsub.uri(c)                    // "localhost:32771" (host:port, no scheme)
//     pubsub.project_id_of(c)          // "pubsub-project"
//     pubsub.emulator_env(c)           // ("PUBSUB_EMULATOR_HOST", "localhost:32771")
//
// The image's emulator command is set in run (the project id is known only
// then) unless the caller's block gave a cmd.
// emulator_env is added: the variable the Google client libraries read to
// talk to the emulator instead of the real service.
//
// Status: compile-checked only (alpha; no engine was used to port it).
//
// Not ported: Go's old flat gcloud.pubsub constructor (deprecated, replaced by
// this module) and the Google Cloud client SDK code of Go's examples (no
// such SDK in Aether; the test drives the emulator over its REST interface or
// a TCP connect instead).

import std.string
import testcontainers as tc
import testcontainers.wait
import testcontainers.docker

exports(
    PubsubContainer, run, terminate, project_id, project_id_of, uri, emulator_env,
    emulator_env_entry, emulator_command, PORT, DEFAULT_PROJECT_ID, DEFAULT_IMAGE, EMULATOR_HOST_VAR,
    pubsub_request_new, pubsub_request_free
)

const PORT = "8085/tcp"
const DEFAULT_PROJECT_ID = "test-project"
const DEFAULT_IMAGE = "gcr.io/google.com/cloudsdktool/cloud-sdk:emulators"
const EMULATOR_HOST_VAR = "PUBSUB_EMULATOR_HOST"

const SET_PROJECT = "pubsub.project_id"

struct PubsubContainer {
    container: *docker.Container
    pid: string
    addr: string
}

pubsub_request_new() -> ptr {
    r = tc.request_new()
    tc.expose(r, PORT)
    tc.wait_for(r, wait.for_all([
        wait.for_listening_port(PORT),
        wait.for_log("started")
    ]))
    tc.set_setting(r, SET_PROJECT, DEFAULT_PROJECT_ID)
    return r
}

pubsub_request_free(p: ptr) { tc.request_free(p) }

// Go's WithProjectID.
project_id(_ctx: ptr, id: string) { tc.set_setting(_ctx, SET_PROJECT, id) }

// The shell command the cloud-sdk image runs (Go's WithCmd "/bin/sh -c ...").
emulator_command(project: string) -> string[] {
    string[] out = []
    out.push("/bin/sh")
    out.push("-c")
    out.push("gcloud beta emulators pubsub start --host-port 0.0.0.0:8085 --project=${project}")
    return out
}

// "NAME=host:port" for an emulator address.
emulator_env_entry(addr: string) -> string { return "${EMULATOR_HOST_VAR}=${addr}" }

builder run(image: string) with pubsub_request_new -> (*PubsubContainer, string) {
    r = _builder
    if r == null { r = pubsub_request_new() }
    pid = tc.req_setting(r, SET_PROJECT)
    // the cloud-sdk image needs the emulator command; a caller's cmd wins, as in Go
    given = tc.req_cmd(r)
    if given.len == 0 { tc.cmd(r, emulator_command(pid)) }
    c, err = tc.run_request(r, image)
    if c == null { return null, "run pubsub: ${err}" }
    g = heap.new(PubsubContainer)
    g.container = c
    g.pid = pid
    g.addr = ""
    if err != "" { return g, "run pubsub: ${err}" }
    // the URI uses the empty string as the protocol: host:port
    ep, eerr = tc.endpoint(c, PORT, "")
    if eerr != "" { return g, "port endpoint: ${eerr}" }
    g.addr = ep
    return g, ""
}

// Terminate the container (null-safe).
terminate(g: *PubsubContainer) -> string {
    if g == null { return "" }
    return tc.terminate(g.container)
}

// The project id the emulator was started with (Go's ProjectID).
project_id_of(g: *PubsubContainer) -> string { return g.pid }

// "host:port" of the emulator (Go's URI).
uri(g: *PubsubContainer) -> string { return g.addr }

// The environment variable (name, value) the Google client libraries read.
emulator_env(g: *PubsubContainer) -> (string, string) { return EMULATOR_HOST_VAR, g.addr }
