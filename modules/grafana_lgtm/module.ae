// Ported from testcontainers-go modules/grafana-lgtm/grafana.go
//
// modules.grafana_lgtm (the Go directory is grafana-lgtm, its package
// grafanalgtm): Grafana's all-in-one OpenTelemetry LGTM image (Loki,
// Grafana, Tempo, Mimir/Prometheus, and an OTLP collector).
//
//     import modules.grafana_lgtm
//
//     c, err = grafana_lgtm.run("grafana/otel-lgtm:0.6.0") {
//         admin_credentials("me", "secret")
//     }
//     defer tc.terminate(c)
//     grafana, _ = grafana_lgtm.http_endpoint(c)       // "localhost:32771"
//     otlp, _ = grafana_lgtm.otlp_http_endpoint(c)
//
// Like Go, the endpoints are "host:port" with no scheme.
//
// Not ported: the Must* variants (no panics here) and the log line Go prints
// with the dashboard URL; the examples use the OpenTelemetry Go SDK.

import testcontainers as tc
import testcontainers.wait
import testcontainers.docker

exports(
    run, admin_credentials, loki_endpoint, tempo_endpoint, http_endpoint,
    otlp_http_endpoint, otlp_grpc_endpoint, prometheus_http_endpoint,
    GRAFANA_PORT, LOKI_PORT, TEMPO_PORT, OTLP_GRPC_PORT, OTLP_HTTP_PORT,
    PROMETHEUS_PORT, DEFAULT_IMAGE, grafana_lgtm_request_new, grafana_lgtm_request_free
)

const GRAFANA_PORT = "3000/tcp"
const LOKI_PORT = "3100/tcp"
const TEMPO_PORT = "3200/tcp"
const OTLP_GRPC_PORT = "4317/tcp"
const OTLP_HTTP_PORT = "4318/tcp"
const PROMETHEUS_PORT = "9090/tcp"
const DEFAULT_IMAGE = "grafana/otel-lgtm:0.6.0"

grafana_lgtm_request_new() -> ptr {
    r = tc.request_new()
    tc.expose(r, GRAFANA_PORT)
    tc.expose(r, LOKI_PORT)
    tc.expose(r, TEMPO_PORT)
    tc.expose(r, OTLP_GRPC_PORT)
    tc.expose(r, OTLP_HTTP_PORT)
    tc.expose(r, PROMETHEUS_PORT)
    tc.wait_for(r, wait.for_all([
        wait.for_log(".*The OpenTelemetry collector and the Grafana LGTM stack are up and running.*") { as_regexp() },
        wait.for_listening_port(GRAFANA_PORT),
        wait.for_listening_port(LOKI_PORT),
        wait.for_listening_port(TEMPO_PORT),
        wait.for_listening_port(OTLP_GRPC_PORT),
        wait.for_listening_port(OTLP_HTTP_PORT),
        wait.for_listening_port(PROMETHEUS_PORT)
    ]) { with_deadline(2m) })
    return r
}

grafana_lgtm_request_free(p: ptr) { tc.request_free(p) }

// Go's WithAdminCredentials.
admin_credentials(_ctx: ptr, user: string, password: string) {
    tc.env(_ctx, "GF_SECURITY_ADMIN_USER", user)
    tc.env(_ctx, "GF_SECURITY_ADMIN_PASSWORD", password)
}

builder run(image: string) with grafana_lgtm_request_new -> (*docker.Container, string) {
    r = _builder
    if r == null { r = grafana_lgtm_request_new() }
    c, err = tc.run_request(r, image)
    if err != "" { return c, "run grafana lgtm: ${err}" }
    return c, ""
}

// Each is "host:port" of that service (Go's *Endpoint).
loki_endpoint(c: *docker.Container) -> (string, string) { return tc.endpoint(c, LOKI_PORT, "") }
tempo_endpoint(c: *docker.Container) -> (string, string) { return tc.endpoint(c, TEMPO_PORT, "") }
http_endpoint(c: *docker.Container) -> (string, string) { return tc.endpoint(c, GRAFANA_PORT, "") }
otlp_http_endpoint(c: *docker.Container) -> (string, string) { return tc.endpoint(c, OTLP_HTTP_PORT, "") }
otlp_grpc_endpoint(c: *docker.Container) -> (string, string) { return tc.endpoint(c, OTLP_GRPC_PORT, "") }
prometheus_http_endpoint(c: *docker.Container) -> (string, string) { return tc.endpoint(c, PROMETHEUS_PORT, "") }
