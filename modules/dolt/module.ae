// Ported from testcontainers-go modules/dolt/dolt.go
//
// modules.dolt: a Dolt SQL server container (MySQL wire protocol). Like
// modules.mysql its container type carries the credentials.
//
//     import modules.dolt
//
//     d, err = dolt.run("dolthub/dolt-sql-server:1.32.4") {
//         database("app")
//         username("app")
//         password("secret")
//         scripts(["testdata/schema.sql"])
//     }
//     defer tc.terminate(d.container)
//     dsn, _ = dolt.connection_string(d, "tls=skip-verify")
//
// As Go does after the caller's options, run applies the default-credentials
// rule: user "root" drops DOLT_USER and DOLT_PASSWORD; any other user needs a
// password ("empty password can be used only with the root user", container
// not started). After the start it creates the database and, for a
// non-root user, the user and its grants, because dolt-sql-server does not.
// Go does that with a database/sql connection; Aether's std has no SQL
// client, so the statements run with `dolt sql -q` inside the container
// (as root over the server's own data directory).
//
// Not ported: MustConnectionString (no Must* in this port) and the
// deprecated RunContainer / WithDefaultCredentials.

import std.string
import testcontainers as tc
import testcontainers.wait
import testcontainers.docker

exports(
    DoltContainer, run, connection_string, database, username, password,
    creds_public_key, clone_remote_url, config_file, creds_file, scripts,
    default_credentials, PORT, DEFAULT_IMAGE, ROOT_USER, DEFAULT_USER,
    DEFAULT_PASSWORD, DEFAULT_DATABASE, dolt_request_new, dolt_request_free
)

const PORT = "3306/tcp"
const DEFAULT_IMAGE = "dolthub/dolt-sql-server:1.32.4"
const ROOT_USER = "root"
const DEFAULT_USER = "test"
const DEFAULT_PASSWORD = "test"
const DEFAULT_DATABASE = "test"

struct DoltContainer {
    container: *docker.Container
    username: string
    password: string
    database: string
}

dolt_request_new() -> ptr {
    r = tc.request_new()
    tc.expose(r, PORT)
    tc.expose(r, "33060/tcp")
    tc.env(r, "DOLT_USER", DEFAULT_USER)
    tc.env(r, "DOLT_PASSWORD", DEFAULT_PASSWORD)
    tc.env(r, "DOLT_DATABASE", DEFAULT_DATABASE)
    tc.wait_for(r, wait.for_log("Server ready. Accepting connections."))
    return r
}

dolt_request_free(p: ptr) { tc.request_free(p) }

username(_ctx: ptr, user: string) { tc.env(_ctx, "DOLT_USER", user) }
password(_ctx: ptr, pw: string) { tc.env(_ctx, "DOLT_PASSWORD", pw) }
database(_ctx: ptr, name: string) { tc.env(_ctx, "DOLT_DATABASE", name) }
creds_public_key(_ctx: ptr, key: string) { tc.env(_ctx, "DOLT_CREDS_PUB_KEY", key) }
clone_remote_url(_ctx: ptr, url: string) { tc.env(_ctx, "DOLT_REMOTE_CLONE_URL", url) }

fn base_name(p: string) -> string {
    rest = p
    i = string.index_of(rest, "/")
    while i >= 0 {
        rest = string.substring(rest, i + 1, string.length(rest))
        i = string.index_of(rest, "/")
    }
    return rest
}

// Go's WithConfigFile: /etc/dolt/servercfg.d/server.cnf.
config_file(_ctx: ptr, host_path: string) {
    tc.file(_ctx, host_path, "/etc/dolt/servercfg.d/server.cnf", 493)
}

// Go's WithCredsFile: into /root/.dolt/creds/ under its base name.
creds_file(_ctx: ptr, host_path: string) {
    tc.file(_ctx, host_path, "/root/.dolt/creds/${base_name(host_path)}", 493)
}

// Go's WithScripts: copied into /docker-entrypoint-initdb.d.
scripts(_ctx: ptr, host_paths: string[]) {
    for p in host_paths {
        tc.file(_ctx, p, "/docker-entrypoint-initdb.d/${base_name(p)}", 493)
    }
}

// Go's withDefaultCredentials, on a request (run calls it after the block):
// the root user needs no DOLT_USER / DOLT_PASSWORD.
default_credentials(r: ptr) {
    if string.to_lower(tc.req_env(r, "DOLT_USER")) == ROOT_USER {
        tc.unset_env(r, "DOLT_USER")
        tc.unset_env(r, "DOLT_PASSWORD")
    }
}

fn sql_run(c: *docker.Container, sql: string) -> string {
    code, out, err = tc.exec(c, ["dolt", "sql", "-q", sql])
    if err != "" { return err }
    if code != 0 { return "exit ${code}: ${out}" }
    return ""
}

builder run(image: string) with dolt_request_new -> (*DoltContainer, string) {
    r = _builder
    if r == null { r = dolt_request_new() }
    default_credentials(r)
    create_user = tc.req_has_env(r, "DOLT_USER")
    user = ROOT_USER
    pw = ""
    if create_user {
        user = tc.req_env(r, "DOLT_USER")
        pw = tc.req_env(r, "DOLT_PASSWORD")
    }
    db = tc.req_env(r, "DOLT_DATABASE")
    if string.length(pw) == 0 && string.to_lower(user) != ROOT_USER {
        tc.request_free(r)
        return null, "empty password can be used only with the root user"
    }
    c, err = tc.run_request(r, image)
    if c == null { return null, "run dolt: ${err}" }
    d = heap.new(DoltContainer)
    d.container = c
    d.username = user
    d.password = pw
    d.database = db
    if err != "" { return d, "run dolt: ${err}" }

    // the image does not create the database or the user
    if string.length(db) > 0 {
        e = sql_run(c, "CREATE DATABASE IF NOT EXISTS ${db};")
        if e != "" { return d, "initialize: error creating database ${db}: ${e}" }
    }
    if create_user {
        e = sql_run(c, "CREATE USER IF NOT EXISTS '${user}' IDENTIFIED BY '${pw}';")
        if e != "" { return d, "initialize: error creating user ${user}: ${e}" }
        e = sql_run(c, "GRANT ALL ON ${db}.* TO '${user}';")
        if e != "" { return d, "initialize: error creating user ${user}: ${e}" }
    }
    return d, ""
}

// "user:password@tcp(host:port)/db?args" (Go's ConnectionString; args are
// joined with &, "" means none).
connection_string(d: *DoltContainer, args: string) -> (string, string) {
    ep, err = tc.endpoint(d.container, PORT, "")
    if err != "" { return "", err }
    extra = ""
    if string.length(args) > 0 { extra = "?${args}" }
    return "${d.username}:${d.password}@tcp(${ep})/${d.database}${extra}", ""
}
