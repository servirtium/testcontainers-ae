// Ported from testcontainers-go modules/dind/dind.go
//
// modules.dind: a Docker-in-Docker container, `dockerd` listening on plain
// tcp port 2375. STATUS: needs a privileged container. With the host cgroup
// namespace (the default, Go's) a rootless Podman machine refuses it; with
// `{ dind_private_cgroupns() }` it runs there (servirtium-vcr's
// pre-recorded/from-testcontainers/dind records against it that way).
//
//     import modules.dind
//
//     c, err = dind.run("docker:28.0.1-dind")
//     defer tc.terminate(c)
//     host, _ = dind.host(c)          // "http://localhost:32771": the inner daemon
//
// Not ported: Go's LoadImage (docker save of a local image through the
// engine, copy of the tar, `docker image load`); the core has no
// image-save call. The inner daemon can be given an image with tc.exec
// ("docker", "pull", ...) instead.

import std.json
import testcontainers as tc
import testcontainers.wait
import testcontainers.docker

exports(run, host, dind_private_cgroupns, PORT, DEFAULT_IMAGE, dind_request_new, dind_request_free)

const PORT = "2375/tcp"
const DEFAULT_IMAGE = "docker:28.0.1-dind"

dind_request_new() -> ptr {
    r = tc.request_new()
    tc.cmd(r, ["dockerd", "-H", "tcp://0.0.0.0:2375", "--tls=false"])
    tc.env(r, "DOCKER_HOST", "tcp://localhost:2375")
    tc.expose(r, PORT)
    tc.wait_for(r, wait.for_listening_port(PORT))
    tc.privileged(r)
    tc.host_config_modifier(r, |hc: ptr| { json.set(hc, "CgroupnsMode", json.str("host")) })
    tc.tmpfs(r, "/run", "")
    tc.tmpfs(r, "/var/run", "")
    return r
}

dind_request_free(p: ptr) { tc.request_free(p) }

builder run(image: string) with dind_request_new -> (*docker.Container, string) {
    r = _builder
    if r == null { r = dind_request_new() }
    c, err = tc.run_request(r, image)
    if err != "" { return c, "run dind: ${err}" }
    return c, ""
}

// Not in Go's module: put the container in its own cgroup namespace instead
// of the host's (the default above, Go's). A rootless engine, such as a
// rootless Podman machine, refuses to let dockerd create cgroups in the
// host's ("mkdir: can't create directory '/sys/fs/cgroup/init': Permission
// denied"); with a private cgroup namespace, still privileged, docker:dind
// runs there. It replaces the host mode set by default (modifiers apply in
// order):
//
//     c, err = dind.run(img) { dind_private_cgroupns() }
dind_private_cgroupns(_ctx: ptr) {
    tc.host_config_modifier(_ctx, |hc: ptr| { json.set(hc, "CgroupnsMode", json.str("private")) })
}

// "http://host:port" of the inner Docker daemon (Go's Host).
host(c: *docker.Container) -> (string, string) {
    return tc.endpoint(c, PORT, "http")
}
