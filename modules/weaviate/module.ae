// Ported from testcontainers-go modules/weaviate/weaviate.go
//
// modules.weaviate: a Weaviate vector database with anonymous access.
//
//     import modules.weaviate
//
//     c, err = weaviate.run("semitechnologies/weaviate:1.29.0")
//     defer tc.terminate(c)
//     scheme, host, _ = weaviate.http_host_address(c)   // "http", "localhost:32771"
//     grpc, _ = weaviate.grpc_host_address(c)           // "localhost:32772"
//
// Not ported: the deprecated RunContainer. (The Go tests use the Weaviate
// client; the test here calls the REST API.)

import testcontainers as tc
import testcontainers.wait
import testcontainers.docker

exports(
    run, http_host_address, grpc_host_address,
    HTTP_PORT, GRPC_PORT, DEFAULT_IMAGE, weaviate_request_new, weaviate_request_free
)

const HTTP_PORT = "8080/tcp"
const GRPC_PORT = "50051/tcp"
const DEFAULT_IMAGE = "semitechnologies/weaviate:1.29.0"

weaviate_request_new() -> ptr {
    r = tc.request_new()
    tc.cmd(r, ["--host", "0.0.0.0", "--scheme", "http", "--port", "8080"])
    tc.expose(r, HTTP_PORT)
    tc.expose(r, GRPC_PORT)
    tc.env(r, "AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED", "true")
    tc.env(r, "PERSISTENCE_DATA_PATH", "/var/lib/weaviate")
    tc.wait_for(r, wait.for_all([
        wait.for_listening_port(HTTP_PORT) { with_startup_timeout(5s) },
        wait.for_listening_port(GRPC_PORT) { with_startup_timeout(5s) },
        wait.for_http("/v1/.well-known/ready") { with_port(HTTP_PORT) }
    ]))
    return r
}

weaviate_request_free(p: ptr) { tc.request_free(p) }

builder run(image: string) with weaviate_request_new -> (*docker.Container, string) {
    r = _builder
    if r == null { r = weaviate_request_new() }
    c, err = tc.run_request(r, image)
    if err != "" { return c, "run weaviate: ${err}" }
    return c, ""
}

// (scheme, "host:port", error): Go's HttpHostAddress returns the two parts.
http_host_address(c: *docker.Container) -> (string, string, string) {
    ep, err = tc.endpoint(c, HTTP_PORT, "")
    if err != "" { return "", "", "port endpoint: ${err}" }
    return "http", ep, ""
}

// "host:port" of the gRPC port (Go's GrpcHostAddress).
grpc_host_address(c: *docker.Container) -> (string, string) {
    return tc.endpoint(c, GRPC_PORT, "")
}
